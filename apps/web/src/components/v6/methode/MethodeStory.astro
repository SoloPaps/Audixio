---
import { t } from '../../../i18n/index.js';
---

<section class="sec wrap story" id="principe" aria-labelledby="h-p" data-component="Story">
 <div class="sh" data-rv><p class="eyebrow">{t('me.p.k')}</p><h2 id="h-p">{t('me.p.h')}</h2><p>{t('me.p.lead')}</p></div>
 <div class="story-g">
  <div class="stage-w">
  <div class="stp" data-stage data-s="5" aria-hidden="true">
   <ol class="st-rail"><li data-r="0"><span>{t('me.sr.0')}</span></li><li data-r="1"><span>{t('me.sr.1')}</span></li><li data-r="2"><span>{t('me.sr.2')}</span></li><li data-r="3"><span>{t('me.sr.3')}</span></li></ol>
   <div class="st-box">
    <div class="sc sc-site">
     <div class="bw"><div class="bw-bar"><i></i><i></i><i></i><span class="num">{t('me.sc.url')}</span><em>{t('me.sc.fic')}</em></div>
      <div class="bw-page"><span class="bk bk-n"></span><span class="bk bk-h"></span><span class="bk bk-t"></span><span class="bk bk-t2"></span><span class="bk bk-i"></span><span class="bk bk-b"></span><span class="scanl"></span></div></div>
     <p class="sc-cap">{t('me.sc.read')}</p>
    </div>
    <div class="sc sc-tests">
     <p class="sc-k"><span>{t('me.dm.tech.n')}</span><span class="sc-k2">{t('me.sc.tk')}</span></p>
     <ul class="tl"><li class="tst v-ok" style="--k:0"><span class="t-d" aria-hidden="true"></span><span class="t-n">{t('me.dm.tech.t0')}</span><span class="t-w num">×3</span><span class="t-s">{t('me.st.pass')}</span><span class="t-v num">{t('me.sv.0')}</span></li><li class="tst v-w" style="--k:1"><span class="t-d" aria-hidden="true"></span><span class="t-n">{t('me.dm.tech.t1')}</span><span class="t-w num">×2</span><span class="t-s">{t('me.st.warn')}</span><span class="t-v num">{t('me.sv.1')}</span></li><li class="tst v-w" style="--k:2"><span class="t-d" aria-hidden="true"></span><span class="t-n">{t('me.dm.tech.t2')}</span><span class="t-w num">×2</span><span class="t-s">{t('me.st.warn')}</span><span class="t-v num">{t('me.sv.2')}</span></li><li class="tst v-ok" style="--k:3"><span class="t-d" aria-hidden="true"></span><span class="t-n">{t('me.dm.tech.t3')}</span><span class="t-w num">×1</span><span class="t-s">{t('me.st.pass')}</span><span class="t-v num">{t('me.sv.3')}</span></li><li class="tst v-ko" style="--k:4"><span class="t-d" aria-hidden="true"></span><span class="t-n">{t('me.dm.tech.t4')}</span><span class="t-w num">×1</span><span class="t-s">{t('me.st.fail')}</span><span class="t-v num">{t('me.sv.4')}</span></li></ul>
     <div class="tsum num"><span class="ts-l">{t('me.sc.sum')}</span><span class="ts-v"><b>6</b> / 9</span></div>
     <div class="tres"><span class="tres-f num">{t('me.sc.calc.1')}<b>{t('me.sc.calc.2')}</b></span><span class="g g-C">C</span></div>
    </div>
    <div class="sc sc-doms">
     <p class="sc-k"><span>{t('me.sc.dk')}</span><span class="sc-k2">{t('me.sc.fic')}</span></p>
     <ul class="dl"><li class="dt" style="--k:0"><svg aria-hidden="true"><use href="#ic-perf"/></svg><span class="dt-n">{t('me.dm.perf.n')}</span><b class="num">72</b><span class="g g-C">C</span></li><li class="dt" style="--k:1"><svg aria-hidden="true"><use href="#ic-seo"/></svg><span class="dt-n">{t('me.dm.seo.n')}</span><b class="num">88</b><span class="g g-B">B</span></li><li class="dt" style="--k:2"><svg aria-hidden="true"><use href="#ic-a11y"/></svg><span class="dt-n">{t('me.dm.a11y.n')}</span><b class="num">64</b><span class="g g-D">D</span></li><li class="dt" style="--k:3"><svg aria-hidden="true"><use href="#ic-eco"/></svg><span class="dt-n">{t('me.dm.eco.n')}</span><b class="num">58</b><span class="g g-D">D</span></li><li class="dt dt-cur" style="--k:4"><svg aria-hidden="true"><use href="#ic-tech"/></svg><span class="dt-n">{t('me.dm.tech.n')}</span><b class="num">67</b><span class="g g-C">C</span></li><li class="dt" style="--k:5"><svg aria-hidden="true"><use href="#ic-sec"/></svg><span class="dt-n">{t('me.dm.sec.n')}</span><b class="num">93</b><span class="g g-A">A</span></li><li class="dt" style="--k:6"><svg aria-hidden="true"><use href="#ic-priv"/></svg><span class="dt-n">{t('me.dm.priv.n')}</span><b class="num">70</b><span class="g g-C">C</span></li><li class="dt" style="--k:7"><svg aria-hidden="true"><use href="#ic-dns"/></svg><span class="dt-n">{t('me.dm.dns.n')}</span><b class="num">40</b><span class="g g-E">E</span></li></ul>
     <div class="tres"><span class="tres-f num">{t('me.sc.avg.1')}<b>{t('me.sc.avg.2')}</b></span><span class="g g-C">C</span></div>
    </div>
    <div class="sc sc-scale">
     <p class="sc-k"><span>{t('me.sc.sk')}</span></p>
     <div class="sbar"><span class="sg g-F" style="--w:35"><b>F</b></span><span class="sg g-E" style="--w:15"><b>E</b></span><span class="sg g-D" style="--w:15"><b>D</b></span><span class="sg g-C on" style="--w:15"><b>C</b></span><span class="sg g-B" style="--w:10"><b>B</b></span><span class="sg g-A" style="--w:10"><b>A</b></span></div>
     <div class="spin-w"><span class="spin num">69</span></div>
     <div class="sax num"><span style="--p:0">0</span><span style="--p:35">35</span><span style="--p:50">50</span><span style="--p:65">65</span><span style="--p:80">80</span><span style="--p:90">90</span><span style="--p:100">100</span></div>
     <p class="sres"><span class="g g-C">C</span><span>{t('me.sc.lvl')}</span></p>
     <ul class="slg num"><li class="g-A"><b>A</b><span>{t('me.g.A')}</span></li><li class="g-B"><b>B</b><span>{t('me.g.B')}</span></li><li class="g-C on"><b>C</b><span>{t('me.g.C')}</span></li><li class="g-D"><b>D</b><span>{t('me.g.D')}</span></li><li class="g-E"><b>E</b><span>{t('me.g.E')}</span></li><li class="g-F"><b>F</b><span>{t('me.g.F')}</span></li></ul>
    </div>
   </div>
  </div>
  </div>
  <ol class="beats">
   <li class="beat" data-b="0"><span class="beat-n num">{t('me.b1.n')}</span><h3>{t('me.b1.h')}</h3><p>{t('me.b1.p')}</p></li>
   <li class="beat" data-b="1"><span class="beat-n num">{t('me.b2.n')}</span><h3>{t('me.b2.h')}</h3><p>{t('me.b2.p')}</p></li>
   <li class="beat" data-b="2"><span class="beat-n num">{t('me.b3.n')}</span><h3>{t('me.b3.h')}</h3><p>{t('me.b3.p')}</p></li>
   <li class="beat" data-b="3"><span class="beat-n num">{t('me.b4.n')}</span><h3>{t('me.b4.h')}</h3><p>{t('me.b4.p')}</p></li>
   <li class="beat" data-b="4"><span class="beat-n num">{t('me.b5.n')}</span><h3>{t('me.b5.h')}</h3><p>{t('me.b5.p')}</p></li>
   <li class="beat" data-b="5"><span class="beat-n num">{t('me.b6.n')}</span><h3>{t('me.b6.h')}</h3><p>{t('me.b6.p')}</p><a class="lnk" href="#bareme"><span class="lnk-i"><svg aria-hidden="true"><use href="#i-chart"/></svg></span><span>{t('me.b6.l')}</span><svg class="lnk-a" aria-hidden="true"><use href="#i-arrow"/></svg></a></li>
  </ol>
 </div>
 <p class="note" data-rv>{t('me.st.note')}</p>
</section>
