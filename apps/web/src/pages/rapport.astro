---
import '../styles/maquettes/liens.css';
import '../styles/maquettes/hub.css';
import GuestReportRedirect from '../components/GuestReportRedirect.astro';
import ReportView from '../components/ReportView.svelte';
import { t } from '../i18n/index.js';
import Canon from '../layouts/Canon.astro';
---

<Canon vue="hub" title={t('meta.report.title')} description={t('meta.report.description')}>
  <GuestReportRedirect slot="head" mode="report" />
  <main id="contenu" class="wrap">
    <ReportView mode="report" client:load />
  </main>
</Canon>
