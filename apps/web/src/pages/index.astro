          <div class="panel" role="tabpanel" id="panel-seo" aria-labelledby="tab-seo" tabindex="0" hidden>
            <header class="p-top">
              <span class="p-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></span>
