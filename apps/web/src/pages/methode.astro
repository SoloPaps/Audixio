---
import MethodeDomains from '../components/v6/methode/MethodeDomains.astro';
import MethodeFaq from '../components/v6/methode/MethodeFaq.astro';
import MethodeFinal from '../components/v6/methode/MethodeFinal.astro';
import MethodeFormula from '../components/v6/methode/MethodeFormula.astro';
import MethodeHero from '../components/v6/methode/MethodeHero.astro';
import MethodeLimits from '../components/v6/methode/MethodeLimits.astro';
import MethodeNever from '../components/v6/methode/MethodeNever.astro';
import MethodeScale from '../components/v6/methode/MethodeScale.astro';
import MethodeStory from '../components/v6/methode/MethodeStory.astro';
import SectionDock from '../components/v6/SectionDock.svelte';
import { t } from '../i18n/index.js';
import { methodeEn } from '../i18n/methode-en.js';
import { methodeFr } from '../i18n/methode-fr.js';
import V6Page from '../layouts/V6Page.astro';
import '../styles/maquettes/methode-v6.css';

const sections = [
  { id: 'principe', label: t('me.d.1') },
  { id: 'bareme', label: t('me.d.2') },
  { id: 'domaines', label: t('me.d.3') },
  { id: 'method-repro', label: t('me.d.4') },
  { id: 'method-never', label: t('me.d.5') },
  { id: 'limites', label: t('me.d.6') },
  { id: 'faq', label: t('me.d.7') },
];

/** Textes calculés dans le navigateur (score essayé, calculette), en FR et en EN. */
const JS_KEYS = [
  'me.js.try.out',
  'me.js.l.A',
  'me.js.l.B',
  'me.js.l.C',
  'me.js.l.P',
  'me.js.calc.off',
  'me.js.calc.none',
  'me.js.calc.res',
  'me.js.calc.live',
  'me.js.calc.livent',
] as const;
const pack = JSON.stringify({
  fr: Object.fromEntries(JS_KEYS.map((key) => [key, methodeFr[key]])),
  en: Object.fromEntries(JS_KEYS.map((key) => [key, methodeEn[key]])),
}).replace(/</g, '\\u003c');
---

<V6Page
  vue="methode"
  title={t('meta.method.title')}
  description={t('meta.method.description')}
  robots="index, follow"
>
  <main id="contenu" class="me" tabindex="-1">
    <MethodeHero />
    <MethodeStory />
    <MethodeScale />
    <MethodeDomains />
    <MethodeFormula />
    <MethodeNever />
    <MethodeLimits />
    <MethodeFaq />
    <MethodeFinal />
  </main>
  <SectionDock {sections} client:idle />
  <script type="application/json" id="me-i18n" set:html={pack} />
</V6Page>

<script>
  import { bootMethode } from '../lib/motion/methode-v6';

  const root = document.querySelector<HTMLElement>('main.me');
  if (root) bootMethode(root);
</script>
