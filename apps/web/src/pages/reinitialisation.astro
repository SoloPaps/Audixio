---
import '../styles/maquettes/auth-v6.css';
import ResetForm from '../components/ResetForm.svelte';
import { t } from '../i18n/index.js';
import V6Page from '../layouts/V6Page.astro';
---

<V6Page vue="auth" title={t('meta.reset.title')} description={t('meta.reset.description')}>
  <div class="au">
  <main id="contenu" class="auth-doc" tabindex="-1">
    <ResetForm
      renew={Astro.url.searchParams.get('etape') === 'nouveau'}
      client:load
    />
  </main>
  </div>
</V6Page>
