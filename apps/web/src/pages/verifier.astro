import VerificationPanel from '../components/VerificationPanel.svelte';
import { t } from '../i18n/index.js';
import V6Page from '../layouts/V6Page.astro';
---

<V6Page vue="preuve" title={t('meta.verify.title')} description={t('meta.verify.description')}>
