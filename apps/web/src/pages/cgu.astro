---
import '../styles/maquettes/cgu-v6.css';
import { t } from '../i18n/index.js';
import V6Page from '../layouts/V6Page.astro';
---

<V6Page vue="cgu" title={t('mq.meta.cgu.title')} description={t('mq.meta.cgu.desc')} robots="index, follow">
<main id="contenu" class="lgc" data-port tabindex="-1" data-reading="1" data-copy-prefix={t('mq.lg.111')}>
<div class="progress" aria-hidden="true"></div>
<nav class="crumbs" aria-label={t('mq.lg.001')}><ol><li><a href="/">{t('mq.lg.002')}</a></li><li>{t('mq.lg.003')}</li><li><span aria-current="page">{t('mq.lg.112')}</span></li></ol></nav>
<div class="hero l-hero"><div data-stagger>
<p class="eyebrow rv"><span class="dot" aria-hidden="true"></span>{t('mq.lg.113')}</p>
<h1 class="rv">{t('mq.lg.112')}</h1>
<p class="lede rv">{t('mq.lg.114')}</p>
<div class="meta rv"><span class="chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>{t('mq.lg.115')}<time datetime="2026-10-24">{t('mq.lg.116')}</time></span></span><span class="chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v16M6 20h12M5 8h14M7 8l-3 6a3 3 0 0 0 6 0zM17 8l-3 6a3 3 0 0 0 6 0z"/></svg>{t('mq.lg.117')}</span><span class="badge b-ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>{t('mq.lg.118')}</span></div></div>
<div class="emblem" aria-hidden="true"><svg viewBox="0 0 300 300"><defs><radialGradient id="halo"><stop offset="0" stop-color="#fff" style="stop-color:var(--surf-2)" stop-opacity=".95"/><stop offset="1" stop-color="#DDE4F8" style="stop-color:var(--d-sf, #DDE4F8)" stop-opacity=".15"/></radialGradient></defs>
<circle class="halo" cx="150" cy="150" r="128"/><circle class="ring" cx="150" cy="150" r="128"/><circle class="ring" cx="150" cy="150" r="96" stroke-dasharray="3 7"/>
<g class="orb"><circle cx="150" cy="22" r="6"/><circle cx="278" cy="150" r="4" opacity=".6"/></g><g class="floaty"><path class="draw" d="M104 64h70l34 34v138H104z"/><path class="draw b" d="M174 64v34h34M126 140h58M126 168h58M126 196h36"/></g></svg></div></div><div class="layout"><nav class="toc card rv" aria-label={t('mq.lg.027')}><p class="kicker">{t('mq.lg.028')}</p><ol><li><a href="#gratuit"><span class="n">{t('mq.lg.029')}</span>{t('mq.lg.119')}</a></li><li><a href="#mandat"><span class="n">{t('mq.lg.031')}</span>{t('mq.lg.120')}</a></li><li><a href="#rapports"><span class="n">{t('mq.lg.033')}</span>{t('mq.lg.121')}</a></li><li><a href="#acceptation"><span class="n">{t('mq.lg.035')}</span>{t('mq.lg.122')}</a></li><li><a href="#compte"><span class="n">{t('mq.lg.037')}</span>{t('mq.lg.123')}</a></li><li><a href="#droit"><span class="n">{t('mq.lg.039')}</span>{t('mq.lg.124')}</a></li></ol><p class="note">{t('mq.lg.125')}</p></nav><div class="chapters"><section class="chap card pad rv sheen" id="gratuit" tabindex="-1" aria-labelledby="gratuit-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.029')}</span><div><p class="kicker">{t('mq.lg.126')}<span class="badge b-ok">{t('mq.lg.127')}</span></p><h2 id="gratuit-t"><span class="sr-only">{t('mq.lg.044')}</span>{t('mq.lg.128')}</h2></div></div><p class="prose">{t('mq.lg.129')}</p>
<ul class="ticks"><li style="--i:0"><span class="t"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg></span><span>{t('mq.lg.130')}</span></li></ul></section><section class="chap card pad rv sheen" id="mandat" tabindex="-1" aria-labelledby="mandat-t">
