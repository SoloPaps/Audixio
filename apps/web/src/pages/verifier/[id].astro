---
import { EXEMPLE_DOSSIER_ID } from '@audigy/evidence/browser';
import PreuveMentions from '../../components/PreuveMentions.svelte';
import VerifierPanel from '../../components/VerifierPanel.svelte';
import { t } from '../../i18n/index.js';
import V6Page from '../../layouts/V6Page.astro';
import '../../styles/maquettes/verifier-page-v6.css';

export function getStaticPaths() {
  return [{ params: { id: EXEMPLE_DOSSIER_ID } }];
}

void Astro.params.id;
---

<V6Page
  vue="verifier"
  title={t('meta.verifier.title')}
  description={t('meta.verifier.description')}
>
  <main id="contenu" class="vf verifier-page" tabindex="-1">
    <nav class="crumbs" aria-label={t('nav.pages')}>
      <ol>
        <li><a href="/">{t('nav.home')}</a></li>
        <li><span aria-current="page">{t('verifier.heading')}</span></li>
      </ol>
    </nav>
    <h1>{t('verifier.heading')}</h1>
    <p class="lead">{t('verifier.lead')}</p>
    <section class="vcard">
      <PreuveMentions />
      <VerifierPanel client:load />
    </section>
  </main>
</V6Page>
