---
import '../styles/maquettes/theme-dark-extra.css';
import '../styles/maquettes/accessibilite.css';
import { t } from '../i18n/index.js';
import Canon from '../layouts/Canon.astro';
---

<Canon vue="accessibilite" title={t('mq.meta.accessibilite.title')} description={t('mq.meta.accessibilite.desc')} robots="index, follow">
<main id="contenu" tabindex="-1" data-reading="1" data-ripple="1" data-copied={t('mq.lg.381')} data-copied-long={t('mq.lg.380')}>
<div class="progress" aria-hidden="true"></div>
<div class="hero l-hero"><div data-stagger>
<nav aria-label={t('mq.lg.001')} class="rv"><ol class="crumbs"><li><a href="/">{t('mq.lg.002')}</a></li><li><span>{t('mq.lg.003')}</span></li><li><span aria-current="page">{t('mq.lg.306')}</span></li></ol></nav>
<p class="eyebrow rv"><span class="dot" aria-hidden="true"></span>{t('mq.lg.307')}</p>
<h1 class="rv">{t('mq.lg.308')}</h1>
<p class="lede rv">{t('mq.lg.309')}</p>
<div class="meta rv"><span class="chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>{t('mq.lg.310')}<time datetime="2026-10-27">{t('mq.lg.008')}</time></span></span><span class="badge b-chk">{t('mq.lg.311')}</span></div></div>
<div class="emblem" aria-hidden="true"><svg viewBox="0 0 300 300"><defs><radialGradient id="halo"><stop offset="0" stop-color="#fff" stop-opacity=".95"/><stop offset="1" stop-color="#DDE4F8" stop-opacity=".15"/></radialGradient></defs>
<circle class="halo" cx="150" cy="150" r="128"/><circle class="ring" cx="150" cy="150" r="128"/><circle class="ring" cx="150" cy="150" r="96" stroke-dasharray="3 7"/>
<g class="spin"><circle cx="150" cy="150" r="128"/></g><g class="orb"><circle cx="150" cy="22" r="6"/><circle cx="278" cy="150" r="4" opacity=".6"/></g>
<g class="floaty"><circle class="draw" cx="150" cy="86" r="14"/><path class="draw" d="M92 120l58 12 58-12M150 132v40M150 172l-26 56M150 172l26 56"/><path class="draw b" d="M108 214a52 52 0 1 0 84-50"/></g></svg></div></div>
<section aria-labelledby="recap"><h2 id="recap" class="sr-only">{t('mq.lg.011')}</h2><div class="stats" data-stagger>
<div class="stat card rv tilt"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="4.5" r="1.8"/><path d="M5 8.5l7 1.5 7-1.5M12 10v4.5M12 14.5L9 21M12 14.5l3 6.5"/></svg></span><p class="k">{t('mq.lg.312')}</p><p class="v">{t('mq.lg.313')}</p><p>{t('mq.lg.314')}</p></div>
<div class="stat card rv tilt"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg></span><p class="k">{t('mq.lg.315')}</p><p class="v" style="font-size:26px">{t('mq.lg.170')}</p><p>{t('mq.lg.316')}</p></div>
<div class="stat card rv tilt"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></span><p class="k">{t('mq.lg.317')}</p><p class="v" style="font-size:26px">{t('mq.lg.318')}</p><p>{t('mq.lg.319')}</p></div>
<div class="stat card rv tilt"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 7l9 6 9-6"/></svg></span><p class="k">{t('mq.lg.320')}</p><p class="v"><span data-count="48">{t('mq.lg.025')}</span><small>{t('mq.lg.321')}</small></p><p>{t('mq.lg.322')}</p></div></div></section>
<div class="layout"><nav class="toc card rv" aria-label={t('mq.lg.027')}><p class="kicker">{t('mq.lg.323')}</p><ol><li><a href="#etat"><span class="n">{t('mq.lg.029')}</span>{t('mq.lg.324')}</a></li><li><a href="#referentiels"><span class="n">{t('mq.lg.031')}</span>{t('mq.lg.315')}</a></li><li><a href="#choix"><span class="n">{t('mq.lg.033')}</span>{t('mq.lg.325')}</a></li><li><a href="#signalement"><span class="n">{t('mq.lg.035')}</span>{t('mq.lg.040')}</a></li><li><a href="#recours"><span class="n">{t('mq.lg.037')}</span>{t('mq.lg.326')}</a></li></ol><p class="note">{t('mq.lg.327')}</p></nav>
<div class="chapters"><section class="chap card pad rv sheen" id="etat" tabindex="-1" aria-labelledby="etat-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.029')}</span><div><p class="kicker">{t('mq.lg.328')}<span class="badge b-chk">{t('mq.lg.329')}</span></p><h2 id="etat-t"><span class="sr-only">{t('mq.lg.044')}</span>{t('mq.lg.324')}</h2></div></div><div class="callout warn rv" style="margin-top:0"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><div><h3>{t('mq.lg.330')}<time datetime="2026-10-27">{t('mq.lg.008')}</time></h3><p>{t('mq.lg.331')}<strong>{t('mq.lg.332')}</strong>{t('mq.lg.333')}</p></div></div>
<p class="prose" style="margin-top:var(--s4)">{t('mq.lg.334')}<strong>{t('mq.lg.313')}</strong>{t('mq.lg.335')}</p></section><section class="chap card pad rv sheen" id="referentiels" tabindex="-1" aria-labelledby="referentiels-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.031')}</span><div><p class="kicker">{t('mq.lg.336')}<span class="badge b-own">{t('mq.lg.337')}</span></p><h2 id="referentiels-t"><span class="sr-only">{t('mq.lg.054')}</span>{t('mq.lg.338')}</h2></div></div><p class="prose">{t('mq.lg.339')}</p>
<div class="grid2" data-stagger><div class="tile card rv"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg></span><h3>{t('mq.lg.170')}</h3><p>{t('mq.lg.340')}</p><span class="chip">{t('mq.lg.341')}</span></div>
<div class="tile card rv"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18"/></svg></span><h3>{t('mq.lg.342')}</h3><p>{t('mq.lg.343')}</p><span class="chip">{t('mq.lg.344')}</span></div></div></section><section class="chap card pad rv sheen" id="choix" tabindex="-1" aria-labelledby="choix-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.033')}</span><div><p class="kicker">{t('mq.lg.345')}<span class="badge b-ok">{t('mq.lg.346')}</span></p><h2 id="choix-t"><span class="sr-only">{t('mq.lg.063')}</span>{t('mq.lg.347')}</h2></div></div><p class="prose">{t('mq.lg.348')}</p>
<div class="grid2" data-stagger>
<div class="tile card rv"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 8l-5 4 5 4M16 8l5 4-5 4M13 5l-2 14"/></svg></span><h3>{t('mq.lg.349')}</h3><p>{t('mq.lg.350')}</p></div>
<div class="tile card rv"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></span><h3>{t('mq.lg.351')}</h3><p>{t('mq.lg.352')}</p></div>
<div class="tile card rv"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="4.5" r="1.8"/><path d="M5 8.5l7 1.5 7-1.5M12 10v4.5M12 14.5L9 21M12 14.5l3 6.5"/></svg></span><h3>{t('mq.lg.353')}</h3><p>{t('mq.lg.354')}</p></div>
<div class="tile card rv"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span><h3>{t('mq.lg.355')}</h3><p>{t('mq.lg.356')}</p></div></div></section><section class="chap card pad rv sheen" id="signalement" tabindex="-1" aria-labelledby="signalement-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.035')}</span><div><p class="kicker">{t('mq.lg.357')}<span class="badge b-own">{t('mq.lg.092')}</span></p><h2 id="signalement-t"><span class="sr-only">{t('mq.lg.069')}</span>{t('mq.lg.358')}</h2></div></div><p class="prose">{t('mq.lg.359')}</p>
<div class="mail card rv"><div><p class="lbl">{t('mq.lg.360')}</p><a class="addr" href="mailto:Audixio@outlook.fr">{t('mq.lg.100')}</a><p class="lbl" style="margin:8px 0 0">{t('mq.lg.361')}</p></div>
<div class="acts"><button type="button" class="btn btn-ghost cp" data-copy="Audixio@outlook.fr" data-msg="Adresse copiée : Audixio@outlook.fr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M5 15V6a2 2 0 0 1 2-2h8"/></svg><span class="bl">{t('mq.lg.102')}</span></button><a class="btn btn-primary" href="mailto:Audixio@outlook.fr?subject=Signalement%20accessibilit%C3%A9"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 7l9 6 9-6"/></svg>{t('mq.lg.103')}</a></div></div></section><section class="chap card pad rv sheen" id="recours" tabindex="-1" aria-labelledby="recours-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.037')}</span><div><p class="kicker">{t('mq.lg.362')}<span class="badge b-own">{t('mq.lg.363')}</span></p><h2 id="recours-t"><span class="sr-only">{t('mq.lg.078')}</span>{t('mq.lg.326')}</h2></div></div><p class="prose">{t('mq.lg.364')}</p>
<ol class="steps" data-stagger><li class="rv"><span class="sn" aria-hidden="true">{t('mq.lg.029')}</span><div><h3>{t('mq.lg.365')}</h3><p>{t('mq.lg.366')}</p><a href="https://www.defenseurdesdroits.fr/" rel="noopener">{t('mq.lg.367')}<span class="sr-only">{t('mq.lg.299')}</span></a></div></li><li class="rv"><span class="sn" aria-hidden="true">{t('mq.lg.031')}</span><div><h3>{t('mq.lg.368')}</h3><p>{t('mq.lg.369')}</p></div></li><li class="rv"><span class="sn" aria-hidden="true">{t('mq.lg.033')}</span><div><h3>{t('mq.lg.370')}</h3><p>{t('mq.lg.371')}</p><address>{t('mq.lg.372')}<br>{t('mq.lg.373')}<br>{t('mq.lg.374')}</address></div></li></ol></section></div></div>
<section class="end card rv sheen" aria-labelledby="end-t"><h2 id="end-t">{t('mq.lg.375')}</h2><p>{t('mq.lg.376')}</p><div class="acts"><a class="btn btn-primary" href="mailto:Audixio@outlook.fr?subject=Signalement%20accessibilit%C3%A9"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 7l9 6 9-6"/></svg>{t('mq.lg.377')}</a><a class="btn btn-ghost" href="/">{t('mq.lg.378')}</a></div><p class="rel">{t('mq.lg.379')}<a href="/mentions-legales">{t('mq.lg.004')}</a> · <a href="/confidentialite">{t('mq.lg.110')}</a> · <a href="/robot">{t('mq.lg.097')}</a></p></section>
<div class="toast" id="toast" aria-hidden="true"></div><p class="sr-only" id="live" role="status" aria-live="polite"></p>
</main>
<script>
import { bindMaquetteMotion, bindReadingAids, bindRipple } from '../lib/motion';
bindMaquetteMotion();
const root = document.getElementById('contenu');
if (root?.dataset.reading === '1') bindReadingAids(root.dataset.copyPrefix ?? '');
if (root?.dataset.ripple === '1') bindRipple({ copied: root.dataset.copied ?? '', copiedLong: root.dataset.copiedLong ?? '' });
document.dispatchEvent(new Event('audixio-motion'));
</script>
</Canon>
