          </button>
          <button class="tab" role="tab" id="tab-qualite" aria-selected="false" aria-controls="panel-qualite" tabindex="-1" type="button">
            <span class="t-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/></svg></span>
            <span class="t-name">{t('mq.a.040')}</span>
            <span class="grade g-c" aria-hidden="true">{t('mq.a.019')}</span>
          </button>
