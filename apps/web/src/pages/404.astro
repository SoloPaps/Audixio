---
import '../styles/maquettes/e404.css';
import { t } from '../i18n/index.js';
import Canon from '../layouts/Canon.astro';

const messages = {
  'mq.lg.533': t('mq.lg.533'),
  'mq.lg.534': t('mq.lg.534'),
  'mq.lg.535': t('mq.lg.535'),
  'mq.lg.536': t('mq.lg.536'),
  'mq.lg.537': t('mq.lg.537'),
  'mq.lg.501': t('mq.lg.501'),
  'mq.lg.538': t('mq.lg.538'),
  'mq.lg.539': t('mq.lg.539'),
};
---

<Canon vue="e404" title={t('mq.meta.e404.title')} description={t('mq.meta.e404.desc')} robots="noindex">
<main id="contenu" class="wrap" >
  <nav class="crumbs" aria-label={t('mq.lg.497')}><ol><li><a href="/">{t('mq.lg.002')}</a></li><li aria-current="page">{t('mq.lg.498')}</li></ol></nav>

  <section class="hero" id="hero" aria-labelledby="t-h1">
    <p class="chip fade" style="--d:0s"><i aria-hidden="true"></i><span>{t('mq.lg.499')}</span><span class="sep" aria-hidden="true">•</span><span>{t('mq.lg.498')}</span></p>

    <div class="digits" aria-hidden="true">
      <span class="four">{t('mq.lg.035')}</span>
      <div class="sheet-col">
        <div class="sheet gone" id="sheet">
          <svg class="ghost" viewBox="0 0 100 125" preserveAspectRatio="none" focusable="false"><path d="M9 1H74L99 26V116Q99 124 91 124H9Q1 124 1 116V9Q1 1 9 1Z"/><text x="50" y="76" text-anchor="middle">?</text></svg>
          <canvas id="vapor"></canvas>
        </div>
        <p class="fileinfo">
          <svg class="ico" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/></svg>
          <span>{t('mq.lg.500')}</span><b id="fsize">{t('mq.lg.501')}</b>
          <button class="replay" id="replay" type="button" hidden aria-label={t('mq.lg.502')}><svg class="ico" width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5"/></svg>{t('mq.lg.503')}</button>
        </p>
      </div>
      <span class="four">{t('mq.lg.035')}</span>
    </div>

    <h1 id="t-h1"><span class="w" style="--w:0">{t('mq.lg.504')}</span> <span class="w" style="--w:1">{t('mq.lg.505')}</span> <span class="w" style="--w:2">{t('mq.lg.506')}</span> <span class="w grad" style="--w:3">{t('mq.lg.507')}</span> <span class="w" style="--w:4">{t('mq.lg.508')}</span> <span class="w" style="--w:5">{t('mq.lg.509')}</span></h1>
    <p class="lead fade" style="--d:.7s">{t('mq.lg.510')}<strong>{t('mq.lg.511')}</strong>{t('mq.lg.512')}</p>
    <p class="req fade" style="--d:.8s" id="reqBox" hidden>{t('mq.lg.513')}<code id="reqPath"></code></p><br>
    <div class="cta fade" style="--d:.9s">
      <a class="btn btn-primary" href="/">{t('mq.lg.514')}<svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      <a class="btn btn-ghost" href="/"><svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" style="color:var(--teal)"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg>{t('mq.lg.515')}</a>
      <button class="btn btn-text" type="button" id="backBtn"><svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>{t('mq.lg.516')}</button>
    </div>
  </section>

  <section class="quick" aria-labelledby="t-quick">
    <div class="q-h">
      <div>
        <p class="eyebrow">{t('mq.lg.517')}</p>
        <h2 id="t-quick">{t('mq.lg.518')}</h2>
      </div>
      <div class="search">
        <label for="q">{t('mq.lg.519')}</label>
        <svg class="ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input id="q" type="search" placeholder={t('mq.lg.520')} autocomplete="off" aria-controls="cards">
      </div>
    </div>
    <ul class="cards" id="cards">
      <li class="card" data-k="accueil audit instantané gratuit santé sécurité empreinte lancer"><a href="/">
        <span class="tile" aria-hidden="true"><svg class="ico" width="22" height="22" viewBox="0 0 24 24"><path d="M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10"/></svg></span>
        <span><h3>{t('mq.lg.521')}<svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></h3><p>{t('mq.lg.522')}</p></span></a></li>
      <li class="card" data-k="méthode 8 domaines référentiels rgesn rgaa core web vitals tls documentation"><a href="/methode">
        <span class="tile" aria-hidden="true"><svg class="ico" width="22" height="22" viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg></span>
        <span><h3>{t('mq.lg.523')}<svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></h3><p>{t('mq.lg.524')}</p></span></a></li>
      <li class="card" data-k="surveillance sites suivis plateformes monitorées rapports horodatés"><a href="/sites">
        <span class="tile" aria-hidden="true"><svg class="ico" width="22" height="22" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/></svg></span>
        <span><h3>{t('mq.lg.525')}<svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></h3><p>{t('mq.lg.526')}</p></span></a></li>
      <li class="card" data-k="assistance contact souverain aide technique lien brisé signaler support"><a href="mailto:Audixio@outlook.fr?subject=Lien%20bris%C3%A9%20(404)">
        <span class="tile" aria-hidden="true"><svg class="ico" width="22" height="22" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M5.6 5.6l3.5 3.5M14.9 14.9l3.5 3.5M18.4 5.6l-3.5 3.5M9.1 14.9l-3.5 3.5"/></svg></span>
        <span><h3>{t('mq.lg.527')}<svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></h3><p>{t('mq.lg.528')}</p></span></a></li>
    </ul>
    <p class="noresult" id="noresult" role="status">{t('mq.lg.529')}</p>

    <aside class="report" aria-labelledby="t-rep">
      <div class="report-l">
        <span class="tile" aria-hidden="true"><svg class="ico" width="22" height="22" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg></span>
        <div>
          <h2 id="t-rep">{t('mq.lg.530')}</h2>
          <p>{t('mq.lg.531')}</p>
        </div>
      </div>
      <a class="mail" id="mailLink" href="mailto:Audixio@outlook.fr">{t('mq.lg.532')}<svg class="ico" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg></a>
    </aside>
  </section>
</main>
<script type="application/json" id="i18n-msg" set:html={JSON.stringify(messages)}></script>
<script>
import { bindMaquetteMotion } from '../lib/motion';
bindMaquetteMotion();
document.dispatchEvent(new Event('audixio-motion'));
</script>
<script is:inline>
var MSG = JSON.parse(document.getElementById('i18n-msg').textContent);

(function(){
MSG['mq.lg.533'];
var $=function(s,c){return (c||document).querySelector(s);};
var reduce=window.matchMedia(MSG['mq.lg.534']).matches;

/* ---------- utilitaires de page ---------- */
var path=location.pathname+location.search;
if(path&&path!=='/'){ $('#reqPath').textContent=path.length>90?path.slice(0,87)+'…':path; $('#reqBox').hidden=false; }
$('#backBtn').addEventListener('click',function(){ if(history.length>1)history.back(); else location.href='/'; });
document.addEventListener('click',function(e){var a=e.target.closest('a[href="#"]');if(a)e.preventDefault();});
/* lien mailto pré-rempli (modifiable par l'utilisateur avant envoi) */
(function(){
  var body=MSG['mq.lg.535']+location.href+(document.referrer?MSG['mq.lg.536']+document.referrer:'')+MSG['mq.lg.537'];
  $('#mailLink').href='mailto:Audixio@outlook.fr?subject='+encodeURIComponent(MSG['mq.lg.538'])+'&body='+encodeURIComponent(body);
})();

/* ---------- filtre des accès rapides ---------- */
var cards=[].slice.call(document.querySelectorAll('.card')),q=$('#q'),nr=$('#noresult');
function norm(s){return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'');}
q.addEventListener('input',function(){
  var v=norm(q.value.trim()),n=0;
  cards.forEach(function(c){
    var hay=norm(c.dataset.k+' '+c.textContent),ok=!v||v.split(/\s+/).every(function(w){return hay.indexOf(w)>-1;});
    c.hidden=!ok;if(ok)n++;
  });
  nr.classList.toggle('on',n===0);
});

/* ---------- LA FEUILLE QUI S'ÉVAPORE ---------- */
var sheet=$('#sheet'),cv=$('#vapor'),fsize=$('#fsize'),replay=$('#replay');
var FILE_KB=48.2,TAU=Math.PI*2;
function fmt(f){return f<=0.001?MSG['mq.lg.501']:(FILE_KB*f).toFixed(1).replace('.',',')+MSG['mq.lg.539'];}
if(reduce||!cv.getContext){fsize.textContent=MSG['mq.lg.501'];return;}
fsize.textContent=fmt(1);replay.hidden=false;sheet.classList.remove('gone');

var ctx=cv.getContext('2d'),SW,SH,STEP,OX,OY,CW,CH,P=[],V=[],T0=0,last=0,visible=true,mx=-999,my=-999,started=false,doneFlag=false,lastTxt='';
var DELAY=1300,DUR=3600,FADE=550;
var clamp=function(v,a,b){return Math.max(a,Math.min(b,v));};
function rr(o,x,y,w,h,r){o.beginPath();o.moveTo(x+r,y);o.lineTo(x+w-r,y);o.quadraticCurveTo(x+w,y,x+w,y+r);o.lineTo(x+w,y+h-r);o.quadraticCurveTo(x+w,y+h,x+w-r,y+h);o.lineTo(x+r,y+h);o.quadraticCurveTo(x,y+h,x,y+h-r);o.lineTo(x,y+r);o.quadraticCurveTo(x,y,x+r,y);o.closePath();o.fill();}
function art(o,w,h){
  var r=w*.09,f=w*.26;
  o.beginPath();o.moveTo(r,0);o.lineTo(w-f,0);o.lineTo(w,f);o.lineTo(w,h-r);o.quadraticCurveTo(w,h,w-r,h);o.lineTo(r,h);o.quadraticCurveTo(0,h,0,h-r);o.lineTo(0,r);o.quadraticCurveTo(0,0,r,0);o.closePath();
  var g=o.createLinearGradient(0,0,w,h);g.addColorStop(0,'#EDE8F5');g.addColorStop(1,'#adbbda');
  o.fillStyle=g;o.fill();o.lineWidth=Math.max(2.4,w*.018);o.strokeStyle='#3D52A0';o.lineJoin='round';o.stroke();
  o.beginPath();o.moveTo(w-f,0);o.lineTo(w-f,f);o.lineTo(w,f);o.closePath();o.fillStyle='#7091E6';o.fill();o.stroke();
  o.fillStyle='#3D52A0';rr(o,w*.14,h*.14,w*.36,h*.055,h*.02);
  o.fillStyle='#7091E6';
  [[.30,.70],[.38,.62],[.46,.70],[.54,.42]].forEach(function(l){rr(o,w*.14,h*l[0],w*l[1],h*.034,h*.012);});
  o.fillStyle='#adbbda';rr(o,w*.14,h*.65,w*.72,h*.2,h*.03);
  o.fillStyle='#7091E6';o.beginPath();o.arc(w*.72,h*.73,w*.06,0,TAU);o.fill();
}
function build(){
  var r=sheet.getBoundingClientRect();SW=Math.max(60,Math.round(r.width));SH=Math.round(SW/.8);
  CW=Math.round(SW*2.6);CH=Math.round(SH*2.3);OX=(CW-SW)/2;OY=Math.round(SH*1.15);
  var dpr=Math.min(window.devicePixelRatio||1,2);
  cv.style.width=CW+'px';cv.style.height=CH+'px';cv.style.left=(-OX)+'px';cv.style.top=(-OY)+'px';
  cv.width=Math.round(CW*dpr);cv.height=Math.round(CH*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);
  var oc=document.createElement('canvas');oc.width=SW;oc.height=SH;var o=oc.getContext('2d');art(o,SW,SH);
  var d=o.getImageData(0,0,SW,SH).data;STEP=Math.max(3,Math.round(SW/42));P=[];V=[];
  for(var y=0;y<SH;y+=STEP)for(var x=0;x<SW;x+=STEP){
    var cx=Math.min(SW-1,x+(STEP>>1)),cy=Math.min(SH-1,y+(STEP>>1)),i=(cy*SW+cx)*4;
    if(d[i+3]<60)continue;
    P.push({hx:x,hy:y,x:x,y:y,c:'rgb('+d[i]+','+d[i+1]+','+d[i+2]+')',th:clamp(((x/SW)*.5+(1-y/SH)*.5)*.8+Math.random()*.2,0,1),st:0,vx:0,vy:0,age:0,life:1,ph:0,amp:0});
  }
}
function launch(p){
  p.st=1;p.vx=(Math.random()-.4)*16;p.vy=-(16+Math.random()*38);p.age=0;p.life=2.2+Math.random()*2.8;p.ph=Math.random()*TAU;p.amp=6+Math.random()*16;
}
function push(p,dt){
  var dx=OX+p.x-mx,dy=OY+p.y-my,d=Math.sqrt(dx*dx+dy*dy);
  if(d<120&&d>.1){var f=(1-d/120)*340*dt;p.vx+=dx/d*f;p.vy+=dy/d*f;}
}
var COL=['#7091E6','#7091E6','#3D52A0','#adbbda'];
function frame(now){
  requestAnimationFrame(frame);
  if(!visible)return;
  if(!T0){T0=now;last=now;}
  var dt=Math.min(.05,(now-last)/1000);last=now;
  var t=now-T0,pr=clamp((t-DELAY)/DUR,0,1),fade=clamp(t/FADE,0,1),i,p,alive=0,n=P.length;
  ctx.clearRect(0,0,CW,CH);
  for(i=0;i<n;i++){
    p=P[i];
    if(p.st===0){
      if(pr>=p.th&&pr>0)launch(p);
      else{
        alive++;
        ctx.globalAlpha=fade;
        ctx.fillStyle=(pr>0&&p.th-pr<.07)?'#7091E6':p.c;
        ctx.fillRect(OX+p.x,OY+p.y,STEP-.5,STEP-.5);
        continue;
      }
    }
    if(p.st===1){
      p.age+=dt;
      if(p.age>=p.life){p.st=2;continue;}
      push(p,dt);
      p.x+=(p.vx+Math.sin(p.age*1.7+p.ph)*p.amp)*dt;p.y+=p.vy*dt;
      p.vy-=7*dt;p.vx*=Math.pow(.985,dt*60);
      var k=p.age/p.life;
      ctx.globalAlpha=Math.pow(1-k,1.2);ctx.fillStyle=p.c;
      var s=STEP*(1-.6*k);ctx.fillRect(OX+p.x,OY+p.y,s,s);
    }
  }
  /* vapeur d'ambiance après l'évaporation */
  if(pr>=.92&&V.length<34&&Math.random()<dt*6){
    V.push({x:Math.random()*SW,y:SH*(.1+Math.random()*.8),vx:(Math.random()-.5)*8,vy:-(10+Math.random()*18),age:0,life:2.6+Math.random()*2.4,ph:Math.random()*TAU,s:2+Math.random()*2.2,c:COL[(Math.random()*4)|0]});
  }
  for(i=V.length-1;i>=0;i--){
    p=V[i];p.age+=dt;if(p.age>=p.life){V.splice(i,1);continue;}
    push(p,dt);p.x+=(p.vx+Math.sin(p.age*1.4+p.ph)*9)*dt;p.y+=p.vy*dt;p.vx*=Math.pow(.985,dt*60);
    var kk=p.age/p.life;ctx.globalAlpha=.55*Math.sin(Math.PI*Math.min(1,kk*1.05));ctx.fillStyle=p.c;
    ctx.fillRect(OX+p.x,OY+p.y,p.s,p.s);
  }
  ctx.globalAlpha=1;
  /* compteur de poids */
  var txt=fmt(n?alive/n:0);if(txt!==lastTxt){fsize.textContent=txt;lastTxt=txt;}
  if(pr>=1&&alive===0&&!doneFlag){doneFlag=true;sheet.classList.add('gone');}
}
function restart(){
  sheet.classList.remove('gone');doneFlag=false;T0=0;V=[];lastTxt='';
  P.forEach(function(p){p.st=0;p.x=p.hx;p.y=p.hy;});
}
replay.addEventListener('click',restart);

document.addEventListener('pointermove',function(e){
  var r=cv.getBoundingClientRect();mx=e.clientX-r.left;my=e.clientY-r.top;
},{passive:true});
document.addEventListener('pointerleave',function(){mx=my=-999;});

build();
if('ResizeObserver' in window){
  var rw=sheet.getBoundingClientRect().width;
  new ResizeObserver(function(){var w=sheet.getBoundingClientRect().width;if(Math.abs(w-rw)>2){rw=w;var wasDone=doneFlag;build();if(wasDone){P.forEach(function(p){p.st=2;});}}}).observe(sheet);
}
if('IntersectionObserver' in window)new IntersectionObserver(function(e){visible=e[0].isIntersecting;}).observe($('.digits'));
requestAnimationFrame(frame);
})();

</script>
</Canon>
