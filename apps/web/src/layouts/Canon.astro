---
import CanonBar from '../components/CanonBar.svelte';
import CanonFooter from '../components/CanonFooter.astro';
import { t } from '../i18n/index.js';
import '../styles/polices.css';
import '../styles/chrome.css';
import '../styles/mobile-fit.css';
import '../styles/theme-dark.css';
import '../styles/maquettes/theme-dark-palette.css';

export type Vue =
  | 'hub'
  | 'domaine'
  | 'restreint'
  | 'preuve'
  | 'constat'
  | 'plan'
  | 'brief'
  | 'badge'
  | 'auth'
  | 'accueil'
  | 'methode'
  | 'exemple'
  | 'progression'
  | 'sites'
  | 'historique'
  | 'compte'
  | 'alertes'
  | 'bienvenue'
  | 'pro'
  | 'passer'
  | 'demande'
  | 'acces'
  | 'pdf'
  | 'mentions'
  | 'cgu'
  | 'confidentialite'
  | 'accessibilite'
  | 'ecologie'
  | 'robot'
  | 'e404'
  | 'e500'
  | 'maintenance'
  | 'cookies'
  | 'audit'
  | 'lancer'
  | 'score'
  | 'partage'
  | 'verifier';

interface Props {
  title: string;
  description: string;
  vue: Vue;
  robots?: string | false;
}

const { title, description, vue, robots = 'noindex, nofollow' } = Astro.props;
const canonical = Astro.url.pathname || '/';
---

<!doctype html>
<html lang="fr" data-theme="light" data-vue={vue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots ? <meta name="robots" content={robots} /> : null}
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#EDE8F5" />
    <link rel="canonical" href={canonical} />
    <script is:inline src="/theme-init.js"></script>
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('has-js');
        var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (d.dataset.vue !== 'restreint' || !calm) d.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#contenu">{t('skip.main')}</a>
    {(vue === 'accueil' || vue === 'methode') ? (
      <nav class="legacy-pages" aria-label={t('nav.pages')}>
        <a class="link-nav" href="/methode" aria-current={Astro.url.pathname === '/methode' ? 'page' : undefined}>{t('nav.method')}</a>
        <a class="link-nav" href="/connexion">{t('nav.login')}</a>
      </nav>
    ) : null}
    <CanonBar pathname={Astro.url.pathname} client:load />
    <slot />
    <CanonFooter classic={vue === 'accueil' || vue === 'methode'} />
    <script>
      import { bootLocale } from '../i18n/live';
      bootLocale();
    </script>
  </body>
</html>
