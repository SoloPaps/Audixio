---
import ReportView from '../components/ReportView.svelte';
import { t } from '../i18n/index.js';
import { maquetteDocument } from '../lib/maquette-html';
import Base from '../layouts/Base.astro';

if (Astro.url.searchParams.get('visuel') === '1') {
  return new Response(maquetteDocument('hub'), {
    headers: { 'content-type': 'text/html; charset=utf-8' },
  });
}
---

<Base shell="canon" title={t('meta.report.title')} description={t('meta.report.description')}>
  <ReportView mode="report" client:load />
</Base>
