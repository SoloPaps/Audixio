---
import { t } from '../../../i18n/index.js';
---

<section class="sec wrap" id="suite" aria-labelledby="h-b">
 <div class="sh" data-rv><p class="eyebrow">{t('ac.235')}</p><h2 id="h-b">{t('ac.236')}</h2><p>{t('ac.237')}</p></div>
 <ul class="feats" data-snap aria-label={t('ac.238')}>
  <li class="feat" data-rv style="--i:0">
   <div class="feat-v" aria-hidden="true">
    <div class="v-brief">
     <p class="v-h"><svg><use href="#i-doc"/></svg>{t('ac.239')}</p>
     <ol><li><i><svg><use href="#i-check"/></svg></i>{t('ac.056')}</li><li><i><svg><use href="#i-check"/></svg></i>{t('ac.224')}</li><li><i><svg><use href="#i-check"/></svg></i>{t('ac.225')}</li></ol>
     <span class="v-copy"><svg><use href="#i-copy"/></svg>{t('ac.240')}</span>
    </div>
   </div>
   <div class="feat-t"><p class="tag">{t('ac.241')}</p><h3>{t('ac.242')}</h3><p>{t('ac.243')}</p>
    <a class="lnk" href="/exemple-rapport"><span class="lnk-i"><svg aria-hidden="true"><use href="#i-doc"/></svg></span>{t('ac.244')}<svg class="lnk-a" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
  </li>
  <li class="feat" data-rv style="--i:1">
   <div class="feat-v" aria-hidden="true">
    <div class="v-share">
     <p class="v-url"><svg><use href="#i-link"/></svg><span>audixio.fr/partage/monsite-exemple</span></p>
     <p class="v-badge"><span class="g g-C">C</span><span><b>{t('ac.245')}</b><small>{t('ac.246')}</small></span></p>
    </div>
   </div>
   <div class="feat-t"><p class="tag">{t('ac.247')}</p><h3>{t('ac.248')}</h3><p>{t('ac.249')}</p>
    <a class="lnk" href="/exemple-rapport"><span class="lnk-i"><svg aria-hidden="true"><use href="#i-link"/></svg></span>{t('ac.250')}<svg class="lnk-a" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
  </li>
  <li class="feat" data-rv style="--i:2">
   <div class="feat-v" aria-hidden="true">
    <div class="v-trend">
     <p class="v-h"><svg><use href="#i-chart"/></svg>{t('ac.251')}</p>
     <svg class="v-chart" viewBox="0 0 300 120" preserveAspectRatio="none"><path class="ax" d="M0 30H300M0 70H300M0 110H300"/><path class="ln" d="M10 92 L70 84 L130 66 L190 58 L250 40 L290 34"/></svg>
     <div class="v-pts"><span class="g g-D" style="--x:3%;--y:77%">D</span><span class="g g-C" style="--x:43%;--y:55%">C</span><span class="g g-B" style="--x:97%;--y:28%">B</span></div>
     <span class="v-cover"></span>
    </div>
   </div>
   <div class="feat-t"><p class="tag tag-soon">{t('ac.252')}</p><h3>{t('ac.253')}</h3><p>{t('ac.254')}</p>
    <a class="lnk" href="/pro"><span class="lnk-i"><svg aria-hidden="true"><use href="#i-spark"/></svg></span>{t('ac.255')}<svg class="lnk-a" aria-hidden="true"><use href="#i-arrow"/></svg></a></div>
  </li>
 </ul>
 <p class="sim-note cap" data-rv>{t('ac.256')}</p>
</section>
