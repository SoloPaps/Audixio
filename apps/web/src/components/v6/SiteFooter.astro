---
import { t } from '../../i18n/index.js';
import { FOOTER_COLUMNS } from '../../lib/nav-canon.js';
---

<footer data-dock-hide>
  <div class="cols">
    <div>
      <a class="v6-logo" href="/" aria-label={t('footer.home')}>
        <img src="/v6/logo.svg" alt="" width="120" height="38" loading="lazy" decoding="async" />
      </a>
      <p class="cap">{t('v6.footer.tag')}</p>
    </div>
    {FOOTER_COLUMNS.map((column) => (
      <nav aria-label={t(column.key)}>
        <h2>{t(column.key)}</h2>
        <ul>
          {column.links.map((link) => (
            <li><a class="link-footer" href={link.href}>{t(link.key)}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <p class="legal">{t('v6.footer.note')}</p>
</footer>
