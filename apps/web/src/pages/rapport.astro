---
import '../styles/maquettes/hub-v6.css';
import GuestReportRedirect from '../components/GuestReportRedirect.astro';
import ReportView from '../components/ReportView.svelte';
import { t } from '../i18n/index.js';
import V6Page from '../layouts/V6Page.astro';
---

<V6Page vue="hub" title={t('meta.report.title')} description={t('meta.report.description')}>
  <GuestReportRedirect slot="head" mode="report" />
  <main id="contenu" class="r6-hub wrap" tabindex="-1">
    <ReportView mode="report" client:load />
  </main>
</V6Page>
