<script is:inline>
(function () {
  var live = document.getElementById('failure-live');
  var demo = document.getElementById('failure-maquette');
  var on = new URLSearchParams(location.search).get('maquette') === '1';
  if (on) {
    if (live) live.remove();
    if (demo) demo.hidden = false;
  } else if (demo) demo.remove();
})();
</script>
