---
import '../styles/maquettes/accueil.css';
import HomeAuditForm from '../components/HomeAuditForm.svelte';
import ScoreGauge from '../components/ScoreGauge.svelte';
import { t } from '../i18n/index.js';
import Canon from '../layouts/Canon.astro';
import { HOME_EXAMPLE_SCORE } from '../lib/home-example.js';
---

<Canon vue="accueil" title={t('home.headline')} description={t('meta.home.description')} robots="index, follow">
<canvas id="bg-canvas" aria-hidden="true"></canvas>

<div class="progress" id="prog" aria-hidden="true"></div>
<div class="c-dot" id="c-dot" aria-hidden="true"></div>
<div class="c-ring" id="c-ring" aria-hidden="true"></div>
<div class="blob-petrol" hidden></div><div class="blob-lilac" hidden></div><main id="contenu">

  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero-copy">
        <p class="pill rv" style="--d:0s"><i aria-hidden="true"></i><span>{t('mq.a.001')}</span></p>
        <h1 id="hero-title">
          <span class="w"><span style="--i:0">{t('mq.a.002')}</span></span>{' '}
          <span class="w"><span style="--i:1">{t('mq.a.003')}</span></span>{' '}
          <span class="w"><span class="grad" style="--i:2">{t('mq.a.004')}</span></span>{' '}
          <span class="w"><span style="--i:3">{t('mq.a.005')}</span></span>{' '}
          <span class="w"><span style="--i:4">{t('mq.a.006')}</span></span>{' '}
          <span class="w"><span class="grad" style="--i:5">{t('mq.a.007')}</span></span>{' '}
          <span class="w"><span style="--i:6">{t('mq.a.008')}</span></span>
        </h1>
        <p class="lead rv" style="--d:.5s">{t('mq.a.009')}</p>
        <p class="lead">{t('home.support')}</p>

        <HomeAuditForm client:load />

        <ul class="trust rv" style="--d:.7s">
          <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 13l4 4L19 7"/></svg>{t('mq.a.010')}</li>
          <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 13l4 4L19 7"/></svg>{t('mq.a.011')}</li>
          <li><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 13l4 4L19 7"/></svg>{t('mq.a.012')}</li>
        </ul>
      </div>
    </div>

    <aside class="stage rv" style="--d:.4s">
      <canvas class="stage-canvas" id="stage-canvas" aria-hidden="true"></canvas>
      <svg class="ecg" id="ecg" viewBox="0 0 1440 220" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
        <path id="ecg-path" d="M0 120H250C262 120 266 104 280 104C294 104 298 120 312 120H380L394 130L412 34L432 188L448 120H500C520 120 528 92 552 92C576 92 584 120 604 120H820L834 130L852 34L872 188L888 120H940C960 120 968 92 992 92C1016 92 1024 120 1044 120H1440"/>
      </svg>

      <figure class="window" id="window" aria-label={t('mq.a.013')}>
        <div class="w-bar" aria-hidden="true">
          <div class="dots"><i></i><i></i><i></i></div>
          <div class="w-url"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><span>{t('mq.a.014')}<b id="url-site">{t('mq.a.015')}</b></span></div>
          <div class="w-spacer"></div>
        </div>
        <div class="win-body" id="exemple">
          <div class="w-left">
            <div class="w-site">
              <small>{t('mq.a.016')}</small>
              <strong id="rep-site">{t('mq.a.015')}</strong>
              <small class="stamp">{t('mq.a.017')}</small>
            </div>

            <div class="score-slot"><ScoreGauge domain={t('domain.global')} score={HOME_EXAMPLE_SCORE} size="compact" /></div>
            <div class="gauge-wrap">
              <div class="gauge" role="img" aria-label={t('mq.a.018')}>
                <svg viewBox="0 0 120 120" aria-hidden="true">
                  <defs>
                    <linearGradient id="gaugeGrad" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0%" stop-color="#3D52A0"/>
                      <stop offset="100%" stop-color="#7091E6"/>
                    </linearGradient>
                  </defs>
                  <circle class="g-track" cx="60" cy="60" r="50"/>
                  <circle class="g-prog" id="g-prog" cx="60" cy="60" r="50"/>
                </svg>
                <div class="g-num" aria-hidden="true"><b id="g-val">{t('mq.a.019')}</b></div>
              </div>
              <div>
                <strong>{t('mq.a.020')}</strong>
                <p>{t('mq.a.021')}</p>
              </div>
            </div>

            <ul class="finds" id="legacy-rows"><li>{t('domain.seo.plain')}</li><li>{t('home.example.https')}</li></ul><div class="finds" id="finds">
              <div class="find ok"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 13l4 4L19 7"/></svg><span><strong>{t('mq.a.024')}</strong> {t('mq.a.025')}</span></div>
              <div class="find warn"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg><span><strong>{t('mq.a.026')}</strong> {t('mq.a.027')}</span></div>
            </div>
          </div>

          <div class="w-right">
            <div class="w-head">
              <h2>{t('mq.a.028')}</h2>
              <span class="tag" id="rep-tag">{t('mq.a.029')}</span>
            </div>
            <p class="w-sub" id="win-sub">{t('mq.a.031')}</p>
            <ul class="rows" id="rows" role="list">
              <li class="row" data-score="62" style="--w:62%">
                <span class="r-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></span>
                <span class="r-name">{t('mq.a.032')}</span>
                <span class="meter g-c" aria-hidden="true"><i></i></span>
                <span class="grade g-c"><span class="sr-only">{t('mq.a.033')} </span>{t('mq.a.019')}</span>
              </li>
              <li class="row" data-score="70" style="--w:70%">
                <span class="r-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></span>
                <span class="r-name">{t('mq.a.034')}</span>
                <span class="meter g-b" aria-hidden="true"><i></i></span>
                <span class="grade g-b"><span class="sr-only">{t('mq.a.033')} </span>{t('mq.a.035')}</span>
              </li>
              <li class="row" data-score="35" style="--w:35%">
                <span class="r-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
                <span class="r-name">{t('mq.a.036')}</span>
                <span class="meter g-d" aria-hidden="true"><i></i></span>
                <span class="grade g-d"><span class="sr-only">{t('mq.a.033')} </span>{t('mq.a.037')}</span>
              </li>
              <li class="row" data-score="58" style="--w:58%">
                <span class="r-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 22s5-2 9-6c4-4 7-9 7-14 0 0-5 2-9 6-4 4-7 9-7 14z"/><path d="M9 16c2-2 5-3 8-3"/></svg></span>
                <span class="r-name">{t('mq.a.038')}</span>
                <span class="meter g-c" aria-hidden="true"><i></i></span>
                <span class="grade g-c"><span class="sr-only">{t('mq.a.033')} </span>{t('mq.a.019')}</span>
              </li>
              <li class="row" data-score="48" style="--w:48%">
                <span class="r-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="4.5" r="2.5"/><path d="M5 9h14M12 9v11m-3-6 3 6 3-6"/></svg></span>
                <span class="r-name">{t('mq.a.039')}</span>
                <span class="meter g-d" aria-hidden="true"><i></i></span>
                <span class="grade g-d"><span class="sr-only">{t('mq.a.033')} </span>{t('mq.a.037')}</span>
              </li>
              <li class="row" data-score="52" style="--w:52%">
                <span class="r-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6"/></svg></span>
                <span class="r-name">{t('mq.a.040')}</span>
                <span class="meter g-c" aria-hidden="true"><i></i></span>
                <span class="grade g-c"><span class="sr-only">{t('mq.a.033')} </span>{t('mq.a.019')}</span>
              </li>
              <li class="row" data-score="40" style="--w:40%">
                <span class="r-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 11c0 3.5-1 6.8-2.75 9.57m-3.44-2.04.05-.09A13.9 13.9 0 0 0 8 11a4 4 0 1 1 8 0c0 1-.07 2-.2 3m-2.12 6.84A21.9 21.9 0 0 0 15.17 17m3.84 1.13c.65-2 1-4.15 1-6.36A10 10 0 0 0 12 2a10 10 0 0 0-9.85 8.3"/></svg></span>
                <span class="r-name">{t('mq.a.041')}</span>
                <span class="meter g-d" aria-hidden="true"><i></i></span>
                <span class="grade g-d"><span class="sr-only">{t('mq.a.033')} </span>{t('mq.a.037')}</span>
              </li>
              <li class="row" data-score="66" style="--w:66%">
                <span class="r-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"/></svg></span>
                <span class="r-name">{t('mq.a.042')}</span>
                <span class="meter g-c" aria-hidden="true"><i></i></span>
                <span class="grade g-c"><span class="sr-only">{t('mq.a.033')} </span>{t('mq.a.019')}</span>
              </li>
            </ul>
          </div>
        </div>
      </figure>
      <p class="sr-only" id="scan-status" role="status" aria-live="polite"></p>
      <p class="win-link"><a class="link lk-pill" href="/exemple-rapport">{t('mq.a.043')}<svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p>
    </aside>
  </section>

  <nav aria-label={t('mq.a.044')}><ul class="qpills"><li><a href="/exemple-rapport"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h9l4 4v14H6zM9 12h7M9 16h7"/></svg>{t('mq.a.045')}</a></li><li><a href="/methode"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 20h16M7 16V9M12 16V5M17 16v-4"/></svg>{t('mq.a.046')}</a></li><li><a href="/pro"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.5 6.7 19.4l1.2-6L3.4 9.3l6-.7z"/></svg>{t('mq.a.047')}</a></li><li><a href="/robot"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 9h14v10H5zM12 4v5M9 14h.01M15 14h.01"/></svg>{t('mq.a.048')}</a></li></ul></nav>
  <section class="proof" aria-label={t('mq.a.049')}>
    <div class="wrap">
      <p class="rv">{t('mq.a.050')}</p>
      <ul class="rv" style="--d:.1s">
        <li>{t('mq.a.051')}</li>
        <li>{t('mq.a.052')}</li>
        <li>{t('mq.a.053')}</li>
        <li>{t('mq.a.054')}</li>
        <li>{t('mq.a.055')}</li>
        <li>{t('mq.a.056')}</li>
      </ul>
    </div>
  </section>

  <section class="section" id="methode" aria-labelledby="domains-title">
    <div class="wrap">
      <div class="s-head rv">
        <p class="eyebrow">{t('mq.a.057')}</p>
        <h2 class="h2" id="domains-title">{t('mq.a.058')}</h2>
        <p class="lead">{t('mq.a.059')}</p>
      </div>

      <div class="explorer rv" id="explorer">
        <div class="tabs" role="tablist" aria-label={t('mq.a.028')} aria-orientation="vertical" id="tablist">
          <button class="tab" role="tab" id="tab-performance" aria-selected="true" aria-controls="panel-performance" tabindex="0" type="button">
            <span class="t-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></span>
            <span class="t-name">{t('mq.a.032')}</span>
            <span class="grade g-c" aria-hidden="true">{t('mq.a.019')}</span>
          </button>
          <button class="tab" role="tab" id="tab-seo" aria-selected="false" aria-controls="panel-seo" tabindex="-1" type="button">
            <span class="t-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg></span>
            <span class="t-name">{t('mq.a.034')}</span>
            <span class="grade g-b" aria-hidden="true">{t('mq.a.035')}</span>
          </button>
          <button class="tab" role="tab" id="tab-securite" aria-selected="false" aria-controls="panel-securite" tabindex="-1" type="button">
            <span class="t-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
            <span class="t-name">{t('mq.a.036')}</span>
            <span class="grade g-d" aria-hidden="true">{t('mq.a.037')}</span>
          </button>
          <button class="tab" role="tab" id="tab-ecologie" aria-selected="false" aria-controls="panel-ecologie" tabindex="-1" type="button">
            <span class="t-ico" aria-hidden="true"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2 22s5-2 9-6c4-4 7-9 7-14 0 0-5 2-9 6-4 4-7 9-7 14z"/><path d="M9 16c2-2 5-3 8-3"/></svg></span>
            <span class="t-name">{t('mq.a.038')}</span>
            <span class="grade g-c" aria-hidden="true">{t('mq.a.019')}</span>
          </button>
          <button class="tab" role="tab" id="tab-accessibilite" aria-selected="false" aria-controls="panel-accessibilite" tabindex="-1" type="button">
