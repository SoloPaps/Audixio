<div class="grid2" data-stagger><div class="tile card rv"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></span><h3>{t('mq.lg.136')}<span class="badge b-ok">{t('mq.lg.137')}</span></h3><p>{t('mq.lg.138')}</p></div>
<div class="tile card rv"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span><h3>{t('mq.lg.139')}<span class="badge b-own">{t('mq.lg.140')}</span></h3><p>{t('mq.lg.141')}</p></div></div>
<blockquote class="law rv"><cite>{t('mq.lg.142')}</cite>{t('mq.lg.143')}</blockquote></section><section class="chap card pad rv sheen" id="rapports" tabindex="-1" aria-labelledby="rapports-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.033')}</span><div><p class="kicker">{t('mq.lg.144')}</p><h2 id="rapports-t"><span class="sr-only">{t('mq.lg.063')}</span>{t('mq.lg.145')}</h2></div></div><p class="prose">{t('mq.lg.146')}<strong>{t('mq.lg.147')}</strong>{t('mq.lg.148')}</p>
<div class="grid2" data-stagger><div class="tile card rv"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><p class="kicker">{t('mq.lg.149')}</p><h3 style="margin-top:8px">{t('mq.lg.150')}</h3><p>{t('mq.lg.151')}</p></div>
<div class="tile card rv"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/></svg></span><p class="kicker">{t('mq.lg.152')}</p><h3 style="margin-top:8px">{t('mq.lg.153')}</h3><p>{t('mq.lg.154')}</p></div></div></section><section class="chap card pad rv sheen" id="acceptation" tabindex="-1" aria-labelledby="acceptation-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.035')}</span><div><p class="kicker">{t('mq.lg.155')}</p><h2 id="acceptation-t"><span class="sr-only">{t('mq.lg.069')}</span>{t('mq.lg.156')}</h2></div></div><p class="prose">{t('mq.lg.157')}</p>
<div class="callout rv"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg></span><div><h3>{t('mq.lg.158')}</h3><p>{t('mq.lg.159')}</p></div></div></section><section class="chap card pad rv sheen" id="compte" tabindex="-1" aria-labelledby="compte-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.037')}</span><div><p class="kicker">{t('mq.lg.160')}</p><h2 id="compte-t"><span class="sr-only">{t('mq.lg.078')}</span>{t('mq.lg.161')}</h2></div></div><p class="prose">{t('mq.lg.162')}</p>
<div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:var(--x-s4)"><a class="btn btn-primary" href="/compte">{t('mq.lg.163')}<span class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a><a class="btn btn-ghost" href="/compte"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>{t('mq.lg.164')}</a></div></section><section class="chap card pad rv sheen" id="droit" tabindex="-1" aria-labelledby="droit-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.039')}</span><div><p class="kicker">{t('mq.lg.165')}</p><h2 id="droit-t"><span class="sr-only">{t('mq.lg.093')}</span>{t('mq.lg.124')}</h2></div></div><p class="prose">{t('mq.lg.166')}</p><div class="mail card rv"><div><p class="lbl">{t('mq.lg.167')}</p><a class="addr" href="mailto:Audixio@outlook.fr">{t('mq.lg.100')}</a></div>
<div class="acts"><button type="button" class="btn btn-ghost copy" data-copy="Audixio@outlook.fr"><span class="cp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M5 15V6a2 2 0 0 1 2-2h8"/></svg></span><span class="ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg></span>{t('mq.lg.102')}</button><a class="btn btn-primary" href="mailto:Audixio@outlook.fr?subject=Question%20sur%20les%20conditions%20d%E2%80%99utilisation"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 7l9 6 9-6"/></svg>{t('mq.lg.103')}</a></div></div></section></div></div>
<section class="end card rv sheen" aria-labelledby="end-t"><h2 id="end-t">{t('mq.lg.168')}</h2><p>{t('mq.lg.169')}</p><div class="acts"><span class="chip">{t('mq.lg.170')}</span><span class="chip">{t('mq.lg.171')}</span><span class="chip">{t('mq.lg.172')}</span></div><p class="rel">{t('mq.lg.108')}<a href="/mentions-legales">{t('mq.lg.004')}</a> · <a href="/confidentialite">{t('mq.lg.110')}</a> · <a href="/robot">{t('mq.lg.097')}</a></p></section>
<div class="toast" id="toast" aria-hidden="true"></div><p class="sr-only" id="live" role="status" aria-live="polite"></p>
</main>
<script>
import { bindMaquetteMotion, bindReadingAids } from '../lib/motion';
bindMaquetteMotion();
const root = document.getElementById('contenu');
if (root?.dataset.reading === '1') bindReadingAids(root.dataset.copyPrefix ?? '');
document.dispatchEvent(new Event('audixio-motion'));
</script>
</V6Page>
