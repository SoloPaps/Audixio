import V6Page from '../layouts/V6Page.astro';
import '../styles/maquettes/sites-liste-v6.css';
import '../styles/maquettes/sites-vide-v6.css';
---

<V6Page vue="sites" title={t('meta.sites.title')} description={t('meta.sites.description')}>
