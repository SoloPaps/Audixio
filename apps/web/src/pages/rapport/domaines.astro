---
import '../../styles/maquettes/domaine-v6.css';
import '../../styles/maquettes/restreint-v6.css';
import GuestReportRedirect from '../../components/GuestReportRedirect.astro';
import ReportView from '../../components/ReportView.svelte';
import { t } from '../../i18n/index.js';
import V6Page from '../../layouts/V6Page.astro';
---

<V6Page vue="domaine" title={t('meta.domain.title')} description={t('meta.domain.description')}>
  <GuestReportRedirect slot="head" mode="domain" />
  <main id="contenu" class="r6-dom" tabindex="-1">
    <ReportView mode="domain" client:load />
  </main>
</V6Page>
