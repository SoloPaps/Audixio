---
import '../styles/maquettes/theme-dark-extra.css';
import '../styles/maquettes/ecologie.css';
import { t } from '../i18n/index.js';
import Canon from '../layouts/Canon.astro';

const messages = {
  'mq.lg.414': t('mq.lg.414'),
  'mq.lg.415': t('mq.lg.415'),
  'mq.lg.416': t('mq.lg.416'),
  'mq.lg.417': t('mq.lg.417'),
  'mq.lg.418': t('mq.lg.418'),
};
---

<Canon vue="ecologie" title={t('mq.meta.ecologie.title')} description={t('mq.meta.ecologie.desc')} robots="noindex, nofollow">
<main id="contenu" tabindex="-1" data-ripple="1" data-copied={t('mq.lg.381')} data-copied-long={t('mq.lg.380')}>

<nav class="crumbs" aria-label={t('mq.lg.001')}><ol><li><a href="/rapport">{t('mq.lg.382')}</a></li><li><span aria-current="page">{t('mq.lg.383')}</span></li></ol></nav>
<div class="hg"><div><p class="eyebrow"><span class="dot" aria-hidden="true"></span>{t('mq.lg.384')}</p>
<h1>{t('mq.lg.383')}</h1><p class="lede">{t('mq.lg.385')}</p></div>
<div class="card pc rv"><div class="ring" id="rg" aria-hidden="true"><svg viewBox="0 0 112 112"><circle class="bg" cx="56" cy="56" r="46"/><circle class="fg" cx="56" cy="56" r="46"/></svg><div class="n"><span><span id="done">{t('mq.lg.181')}</span><small>{t('mq.lg.386')}</small></span></div></div><div><b>{t('mq.lg.387')}</b><p id="prg" aria-live="polite">{t('mq.lg.388')}</p></div></div></div>
<p class="info rv"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg><span>{t('mq.lg.389')}</span></p>
<form id="qf"><div class="qs" data-stagger><fieldset class="q rv" id="f1" aria-describedby="d1"><legend>{t('mq.lg.390')}<span class="crit">{t('mq.lg.391')}</span></legend><span class="num" aria-hidden="true">{t('mq.lg.029')}</span><p class="qt" id="d1">{t('mq.lg.392')}</p><div class="opts"><label class="opt y"><input type="radio" name="q1" value="Oui"><span><i aria-hidden="true"></i>{t('mq.lg.393')}</span></label><label class="opt n"><input type="radio" name="q1" value="Non"><span><i aria-hidden="true"></i>{t('mq.lg.394')}</span></label><label class="opt u"><input type="radio" name="q1" value="Je ne sais pas"><span><i aria-hidden="true"></i>{t('mq.lg.395')}</span></label></div></fieldset><fieldset class="q rv" id="f2" aria-describedby="d2"><legend>{t('mq.lg.396')}<span class="crit">{t('mq.lg.397')}</span></legend><span class="num" aria-hidden="true">{t('mq.lg.031')}</span><p class="qt" id="d2">{t('mq.lg.398')}</p><div class="opts"><label class="opt y"><input type="radio" name="q2" value="Oui"><span><i aria-hidden="true"></i>{t('mq.lg.393')}</span></label><label class="opt n"><input type="radio" name="q2" value="Non"><span><i aria-hidden="true"></i>{t('mq.lg.394')}</span></label><label class="opt u"><input type="radio" name="q2" value="Je ne sais pas"><span><i aria-hidden="true"></i>{t('mq.lg.395')}</span></label></div></fieldset><fieldset class="q rv" id="f3" aria-describedby="d3"><legend>{t('mq.lg.399')}<span class="crit">{t('mq.lg.400')}</span></legend><span class="num" aria-hidden="true">{t('mq.lg.033')}</span><p class="qt" id="d3">{t('mq.lg.401')}</p><div class="opts"><label class="opt y"><input type="radio" name="q3" value="Oui"><span><i aria-hidden="true"></i>{t('mq.lg.393')}</span></label><label class="opt n"><input type="radio" name="q3" value="Non"><span><i aria-hidden="true"></i>{t('mq.lg.394')}</span></label><label class="opt u"><input type="radio" name="q3" value="Je ne sais pas"><span><i aria-hidden="true"></i>{t('mq.lg.395')}</span></label></div></fieldset><fieldset class="q rv" id="f4" aria-describedby="d4"><legend>{t('mq.lg.402')}<span class="crit">{t('mq.lg.403')}</span></legend><span class="num" aria-hidden="true">{t('mq.lg.035')}</span><p class="qt" id="d4">{t('mq.lg.404')}</p><div class="opts"><label class="opt y"><input type="radio" name="q4" value="Oui"><span><i aria-hidden="true"></i>{t('mq.lg.393')}</span></label><label class="opt n"><input type="radio" name="q4" value="Non"><span><i aria-hidden="true"></i>{t('mq.lg.394')}</span></label><label class="opt u"><input type="radio" name="q4" value="Je ne sais pas"><span><i aria-hidden="true"></i>{t('mq.lg.395')}</span></label></div></fieldset><fieldset class="q rv" id="f5" aria-describedby="d5"><legend>{t('mq.lg.405')}<span class="crit">{t('mq.lg.406')}</span></legend><span class="num" aria-hidden="true">{t('mq.lg.037')}</span><p class="qt" id="d5">{t('mq.lg.407')}</p><div class="opts"><label class="opt y"><input type="radio" name="q5" value="Oui"><span><i aria-hidden="true"></i>{t('mq.lg.393')}</span></label><label class="opt n"><input type="radio" name="q5" value="Non"><span><i aria-hidden="true"></i>{t('mq.lg.394')}</span></label><label class="opt u"><input type="radio" name="q5" value="Je ne sais pas"><span><i aria-hidden="true"></i>{t('mq.lg.395')}</span></label></div></fieldset><fieldset class="q rv" id="f6" aria-describedby="d6"><legend>{t('mq.lg.408')}<span class="crit">{t('mq.lg.409')}</span></legend><span class="num" aria-hidden="true">{t('mq.lg.039')}</span><p class="qt" id="d6">{t('mq.lg.410')}</p><div class="opts"><label class="opt y"><input type="radio" name="q6" value="Oui"><span><i aria-hidden="true"></i>{t('mq.lg.393')}</span></label><label class="opt n"><input type="radio" name="q6" value="Non"><span><i aria-hidden="true"></i>{t('mq.lg.394')}</span></label><label class="opt u"><input type="radio" name="q6" value="Je ne sais pas"><span><i aria-hidden="true"></i>{t('mq.lg.395')}</span></label></div></fieldset></div>
<div class="bar"><p>{t('mq.lg.411')}</p><div class="r"><button type="button" class="btn btn-ghost" id="later"><span class="bl">{t('mq.lg.412')}</span><span class="spin" aria-hidden="true"></span></button><button type="button" class="btn btn-primary" id="save"><span class="bl">{t('mq.lg.413')}</span><span class="spin" aria-hidden="true"></span></button></div></div></form>

<div class="toast" id="toast" aria-hidden="true"></div><p class="sr-only" id="live" role="status" aria-live="polite"></p>
</main>
<script type="application/json" id="i18n-msg" set:html={JSON.stringify(messages)}></script>
<script>
import { bindMaquetteMotion, bindRipple } from '../lib/motion';
bindMaquetteMotion();
const root = document.getElementById('contenu');
if (root?.dataset.ripple === '1') bindRipple({ copied: root.dataset.copied ?? '', copiedLong: root.dataset.copiedLong ?? '' });
document.dispatchEvent(new Event('audixio-motion'));
</script>
<script is:inline>
var MSG = JSON.parse(document.getElementById('i18n-msg').textContent);

(function(){var d=document,f=d.getElementById('qf'),K='audixio-rgesn';
function upd(){var n=0;for(var i=1;i<=6;i++){var c=f.querySelector('[name=q'+i+']:checked');d.getElementById('f'+i).classList.toggle('ans',!!c);if(c)n++}
 d.getElementById('done').textContent=n;var r=d.getElementById('rg');r.style.setProperty('--p',n/6);r.classList.toggle('full',n===6);
 d.getElementById('prg').textContent=n+(n>1?L('mq.lg.414'):L('mq.lg.415'))+L('mq.lg.416')}
function L(k){try{if(localStorage.getItem('audigy-locale')==='en'){var p=window.__audigy_en||JSON.parse(localStorage.getItem('audigy-en')||'null');if(p&&p[k])return p[k]}}catch(e){}return MSG[k]}
try{var s=JSON.parse(localStorage.getItem(K)||'{}');Object.keys(s).forEach(function(k){var e=f.querySelector('[name='+k+'][value="'+s[k]+'"]');if(e)e.checked=true})}catch(e){}
f.addEventListener('change',upd);upd();
d.getElementById('save').addEventListener('click',function(){var o={};f.querySelectorAll('input:checked').forEach(function(e){o[e.name]=e.value});AX.busy(this,700,function(){try{localStorage.setItem(K,JSON.stringify(o))}catch(e){}AX.say(MSG['mq.lg.417'],true)})});
d.getElementById('later').addEventListener('click',function(){AX.say(MSG['mq.lg.418'],true)});
})();

</script>
</Canon>
