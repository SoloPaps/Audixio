---
import { t } from '../../../i18n/index.js';
---

<section class="sec wrap" id="method-never" aria-labelledby="h-n">
 <div class="sh" data-rv><p class="eyebrow">{t('me.n.k')}</p><h2 id="h-n">{t('me.n.h')}</h2></div>
 <ul class="rules">
  <li data-rv style="--i:0"><span class="ib"><svg aria-hidden="true"><use href="#ic-lock"/></svg></span><h3>{t('me.n1.h')}</h3><p>{t('me.n1.p')}</p></li>
  <li data-rv style="--i:1"><span class="ib"><svg aria-hidden="true"><use href="#i-eye"/></svg></span><h3>{t('me.n2.h')}</h3><p>{t('me.n2.p')}</p></li>
  <li data-rv style="--i:2"><span class="ib"><svg aria-hidden="true"><use href="#i-down"/></svg></span><h3>{t('me.n3.h')}</h3><p>{t('me.n3.p')}</p></li>
  <li data-rv style="--i:3"><span class="ib"><svg aria-hidden="true"><use href="#i-scan"/></svg></span><h3>{t('me.n4.h')}</h3><p>{t('me.n4.p')}</p></li>
 </ul>
 <p class="more-row" data-rv><a class="lnk" href="/robot"><span class="lnk-i"><svg aria-hidden="true"><use href="#i-scan"/></svg></span><span>{t('me.n.link')}</span><svg class="lnk-a" aria-hidden="true"><use href="#i-arrow"/></svg></a></p>
</section>
