{
  "extends": "./tsconfig.base.json",
  "include": [
    "apps/**/*.ts",
    "apps/**/*.d.ts",
    "packages/**/*.ts",
    "packages/**/*.d.ts",
    "fixtures/**/*.ts",
    "scripts/**/*.ts",
    "netlify/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist",
    "**/.astro",
    "apps/web/src/lib/rose.ts",
    "apps/web/src/lib/motion.ts",
    "apps/web/src/lib/espace-motion.ts",
    "apps/web/src/lib/espace-boot.ts",
    "apps/web/src/lib/constat-stage.ts",
    "apps/web/src/lib/theme-role.ts",
    "apps/web/src/i18n/live.ts",
    "apps/web/src/i18n/locale-meta.test.ts",
    "apps/web/src/lib/progress-scene.ts",
    "apps/web/src/lib/motion/accueil-v6.ts",
    "apps/web/src/lib/motion/methode-v6.ts"
  ]
}
