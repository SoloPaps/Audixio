</main>
<div class="toast" role="status" aria-live="polite"></div>
<script type="application/json" id="i18n-msg" set:html={JSON.stringify(messages)}></script>
<script>
import { readAudit } from '../lib/audit-api';
import { currentSession } from '../lib/browser-session';
import { failureView } from '../lib/failure-view';
import { readGuestAudit } from '../lib/guest-store';
import { retryHref } from '../lib/relaunch';

const params = new URLSearchParams(location.search);
if (params.get('maquette') !== '1') {
  const paint = (payload: Parameters<typeof failureView>[0]): void => {
    const view = failureView(payload);
    const host = document.getElementById('fail-host');
    const url = document.getElementById('fail-url');
    const code = document.getElementById('fail-code');
    const time = document.getElementById('fail-time');
    if (host) host.textContent = view.host;
    // Sans domaine connu, le titre reste « L’audit n’a pas abouti ».
    const named = view.host.trim() !== '';
    document.getElementById('fail-of')?.toggleAttribute('hidden', !named);
    document.getElementById('fail-lead')?.toggleAttribute('hidden', named);
    if (url) url.textContent = view.url;
    if (code) code.textContent = view.code;
    if (time) time.textContent = view.time;
  };
  const button = document.getElementById('retry');
  const id = params.get('id')?.trim() ?? '';
  const stored = id === '' ? null : readGuestAudit(id);
  if (stored) paint(stored);
  if (button) button.dataset.href = retryHref(stored?.audit.site ?? null);
  if (!stored && id !== '') {
    void currentSession().then(async (session) => {
      if (!session) return;
      const result = await readAudit(session.access_token, id);
      if (!result.ok) return;
      paint(result.payload);
      if (button) button.dataset.href = retryHref(result.payload.audit.site);
    });
  }
}
</script>
<script>
import { bindMaquetteMotion } from '../lib/motion';
bindMaquetteMotion();
document.dispatchEvent(new Event('audixio-motion'));
</script>
<script is:inline>
var MSG = JSON.parse(document.getElementById('i18n-msg').textContent);

(function(){var t=document.querySelector(".toast"),tt;window.say=function(m){t.textContent=m;t.classList.add("show");clearTimeout(tt);tt=setTimeout(function(){t.classList.remove("show")},2600)};})();
function seg(group,attr){var bs=document.querySelectorAll('[data-'+group+']');if(!bs.length)return;function show(v,push){bs.forEach(function(b){b.setAttribute('aria-pressed',b.dataset[group]===v?'true':'false')});document.querySelectorAll('['+attr+']').forEach(function(p){p.hidden=p.getAttribute(attr)!==v});if(push)history.replaceState(null,'','#'+v);}
bs.forEach(function(b){b.addEventListener('click',function(){show(b.dataset[group],true)})});var h=location.hash.slice(1);var ok=[].some.call(bs,function(b){return b.dataset[group]===h});show(ok?h:bs[0].dataset[group],false);return show;}seg('cs','data-case');var r=document.getElementById('retry');if(r)r.addEventListener('click',function(){r.classList.add('busy');r.disabled=true;r.querySelector('span').textContent=MSG['mq.lg.648'];var dest=new URLSearchParams(location.search).get('maquette')==='1'?'/progression':(r.dataset.href||'/');setTimeout(function(){location.href=dest},1200)});

</script>
</Canon>
