---
import LaunchAudit from '../components/LaunchAudit.svelte';
import { t } from '../i18n/index.js';
import Canon from '../layouts/Canon.astro';
import '../styles/maquettes/guest-gate.css';
---

<Canon vue="lancer" title={t('meta.launch.title')} description={t('meta.launch.description')}>
  <main id="contenu" class="launch-wait">
    <h1>{t('launch.title')}</h1>
    <LaunchAudit client:load />
  </main>
</Canon>
