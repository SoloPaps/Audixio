---
import '../styles/maquettes/maintenance.css';
import { t } from '../i18n/index.js';
import Canon from '../layouts/Canon.astro';

const messages = {
  'mq.lg.533': t('mq.lg.533'),
  'mq.lg.534': t('mq.lg.534'),
  'mq.lg.536': t('mq.lg.536'),
  'mq.lg.537': t('mq.lg.537'),
  'mq.lg.574': t('mq.lg.574'),
  'mq.lg.575': t('mq.lg.575'),
  'mq.lg.576': t('mq.lg.576'),
  'mq.lg.577': t('mq.lg.577'),
  'mq.lg.649': t('mq.lg.649'),
};
---

<Canon vue="maintenance" title={t('mq.meta.maintenance.title')} description={t('mq.meta.maintenance.desc')} robots="noindex">
<main id="contenu" class="wrap" >
  <nav class="crumbs" aria-label={t('mq.lg.497')}><ol><li><a href="/">{t('mq.lg.002')}</a></li><li aria-current="page">{t('mq.lg.559')}</li></ol></nav>

  <section class="hero" id="hero" aria-labelledby="t-h1">
    <p class="chip fade" style="--d:0s"><i aria-hidden="true"></i><span>{t('mq.lg.560')}</span><span class="sep" aria-hidden="true">•</span><span>{t('mq.lg.561')}</span></p>

    <div class="digits" aria-hidden="true">
      <div class="sheet-col">
        <div class="ring" id="ring">
          <span class="r-glow"></span>
          <svg viewBox="0 0 200 200" focusable="false">
            <defs><linearGradient id="rg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3D52A0"/><stop offset="1" stop-color="#7091E6"/></linearGradient></defs>
            <circle class="r-orbit" cx="100" cy="100" r="98"/>
            <circle class="prog" cx="100" cy="100" r="92"/>
            <g class="g1"><path d="M152.0 100.0 L161.7 105.8 L159.9 116.0 L148.7 118.1 L145.0 126.0 L150.5 135.9 L143.8 143.8 L133.1 140.1 L126.0 145.0 L125.8 156.4 L116.0 159.9 L108.7 151.3 L100.0 152.0 L94.2 161.7 L84.0 159.9 L81.9 148.7 L74.0 145.0 L64.1 150.5 L56.2 143.8 L59.9 133.1 L55.0 126.0 L43.6 125.8 L40.1 116.0 L48.7 108.7 L48.0 100.0 L38.3 94.2 L40.1 84.0 L51.3 81.9 L55.0 74.0 L49.5 64.1 L56.2 56.2 L66.9 59.9 L74.0 55.0 L74.2 43.6 L84.0 40.1 L91.3 48.7 L100.0 48.0 L105.8 38.3 L116.0 40.1 L118.1 51.3 L126.0 55.0 L135.9 49.5 L143.8 56.2 L140.1 66.9 L145.0 74.0 L156.4 74.2 L159.9 84.0 L151.3 91.3Z"/><circle cx="100" cy="100" r="34"/><circle class="hub" cx="100" cy="100" r="12"/></g>
            <g class="g2w"><g class="g2"><path d="M23.0 0.0 L29.7 4.2 L27.7 11.5 L19.8 11.7 L16.3 16.3 L18.0 24.0 L11.5 27.7 L5.7 22.3 L0.0 23.0 L-4.2 29.7 L-11.5 27.7 L-11.7 19.8 L-16.3 16.3 L-24.0 18.0 L-27.7 11.5 L-22.3 5.7 L-23.0 0.0 L-29.7 -4.2 L-27.7 -11.5 L-19.8 -11.7 L-16.3 -16.3 L-18.0 -24.0 L-11.5 -27.7 L-5.7 -22.3 L-0.0 -23.0 L4.2 -29.7 L11.5 -27.7 L11.7 -19.8 L16.3 -16.3 L24.0 -18.0 L27.7 -11.5 L22.3 -5.7Z"/><circle r="9"/></g></g>
            <g class="wrench"><path d="M58 34a14 14 0 0 1 18 17l26 26-7 7-26-26a14 14 0 0 1-17-18l9 9 7-2 2-7z"/></g>
            <circle class="dot" cx="70" cy="42" r="3"/><circle class="dot d2" cx="82" cy="36" r="2.2"/>
          </svg>
        </div>
        <p class="fileinfo status">
          <svg class="ico" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/></svg>
          <span>{t('mq.lg.562')}</span><b id="rstate">{t('mq.lg.563')}</b>
        </p>
      </div>
    </div>

    <h1 id="t-h1"><span class="w" style="--w:0">{t('mq.lg.564')}</span> <span class="w" style="--w:1">{t('mq.lg.565')}</span> <span class="w" style="--w:2">{t('mq.lg.566')}</span> <span class="w grad" style="--w:3">{t('mq.lg.567')}</span></h1>
    <p class="lead fade" style="--d:.7s">{t('mq.lg.568')}<strong>{t('mq.lg.569')}</strong>{t('mq.lg.570')}</p>
    <p class="req fade" style="--d:.8s" id="reqBox" hidden>{t('mq.lg.513')}<code id="reqPath"></code></p><br>
    <div class="cta fade" style="--d:.9s">
      <button class="btn btn-primary retry" type="button" id="retryBtn"><svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5"/></svg>{t('mq.lg.553')}</button>
      <a class="btn btn-ghost" href="/"><svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" style="color:var(--teal)"><path d="M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10"/></svg>{t('mq.lg.107')}</a>
      <button class="btn btn-text" type="button" id="backBtn"><svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>{t('mq.lg.516')}</button>
    </div>
  </section>

  <section class="quick" aria-labelledby="t-quick">
    <div class="q-h">
      <div>
        <p class="eyebrow">{t('mq.lg.517')}</p>
        <h2 id="t-quick">{t('mq.lg.518')}</h2>
      </div>
      <div class="search">
        <label for="q">{t('mq.lg.519')}</label>
        <svg class="ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
        <input id="q" type="search" placeholder={t('mq.lg.520')} autocomplete="off" aria-controls="cards">
      </div>
    </div>
    <ul class="cards" id="cards">
      <li class="card" data-k="accueil audit instantané gratuit santé sécurité empreinte lancer"><a href="/">
        <span class="tile" aria-hidden="true"><svg class="ico" width="22" height="22" viewBox="0 0 24 24"><path d="M3 11l9-8 9 8M5 10v10h5v-6h4v6h5V10"/></svg></span>
        <span><h3>{t('mq.lg.521')}<svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></h3><p>{t('mq.lg.522')}</p></span></a></li>
      <li class="card" data-k="méthode 8 domaines référentiels rgesn rgaa core web vitals tls documentation"><a href="/methode">
        <span class="tile" aria-hidden="true"><svg class="ico" width="22" height="22" viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg></span>
        <span><h3>{t('mq.lg.523')}<svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></h3><p>{t('mq.lg.524')}</p></span></a></li>
      <li class="card" data-k="surveillance sites suivis plateformes monitorées rapports horodatés"><a href="/sites">
        <span class="tile" aria-hidden="true"><svg class="ico" width="22" height="22" viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/></svg></span>
        <span><h3>{t('mq.lg.525')}<svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></h3><p>{t('mq.lg.526')}</p></span></a></li>
      <li class="card" data-k="assistance contact souverain aide technique maintenance indisponible signaler support"><a href="mailto:Audixio@outlook.fr?subject=Page%20en%20maintenance">
        <span class="tile" aria-hidden="true"><svg class="ico" width="22" height="22" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><path d="M5.6 5.6l3.5 3.5M14.9 14.9l3.5 3.5M18.4 5.6l-3.5 3.5M9.1 14.9l-3.5 3.5"/></svg></span>
        <span><h3>{t('mq.lg.527')}<svg class="ico" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></h3><p>{t('mq.lg.571')}</p></span></a></li>
    </ul>
    <p class="noresult" id="noresult" role="status">{t('mq.lg.529')}</p>

    <aside class="report" aria-labelledby="t-rep">
      <div class="report-l">
        <span class="tile" aria-hidden="true"><svg class="ico" width="22" height="22" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg></span>
        <div>
          <h2 id="t-rep">{t('mq.lg.572')}</h2>
          <p>{t('mq.lg.573')}</p>
        </div>
      </div>
      <a class="mail" id="mailLink" href="mailto:Audixio@outlook.fr">{t('mq.lg.532')}<svg class="ico" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg></a>
    </aside>
  </section>
</main>
<script type="application/json" id="i18n-msg" set:html={JSON.stringify(messages)}></script>
<script>
import { bindMaquetteMotion } from '../lib/motion';
bindMaquetteMotion();
document.dispatchEvent(new Event('audixio-motion'));
</script>
<script is:inline>
var MSG = JSON.parse(document.getElementById('i18n-msg').textContent);

(function(){
MSG['mq.lg.533'];
var $=function(s,c){return (c||document).querySelector(s);};
var reduce=window.matchMedia(MSG['mq.lg.534']).matches;

/* ---------- utilitaires de page ---------- */
var path=location.pathname+location.search;
if(path&&path!=='/'){ $('#reqPath').textContent=path.length>90?path.slice(0,87)+'…':path; $('#reqBox').hidden=false; }
$('#backBtn').addEventListener('click',function(){ if(history.length>1)history.back(); else location.href='/'; });
document.addEventListener('click',function(e){var a=e.target.closest('a[href="#"]');if(a)e.preventDefault();});
/* lien mailto pré-rempli (modifiable par l'utilisateur avant envoi) */
(function(){
  var body=MSG['mq.lg.574']+location.href+(document.referrer?MSG['mq.lg.536']+document.referrer:'')+MSG['mq.lg.537'];
  $('#mailLink').href='mailto:Audixio@outlook.fr?subject='+encodeURIComponent(MSG['mq.lg.575'])+'&body='+encodeURIComponent(body);
})();

/* ---------- filtre des accès rapides ---------- */
var cards=[].slice.call(document.querySelectorAll('.card')),q=$('#q'),nr=$('#noresult');
function norm(s){return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'');}
q.addEventListener('input',function(){
  var v=norm(q.value.trim()),n=0;
  cards.forEach(function(c){
    var hay=norm(c.dataset.k+' '+c.textContent),ok=!v||v.split(/\s+/).every(function(w){return hay.indexOf(w)>-1;});
    c.hidden=!ok;if(ok)n++;
  });
  nr.classList.toggle('on',n===0);
});

/* ---------- réessayer ---------- */
$('#retryBtn').addEventListener('click',function(){location.reload();});

/* ---------- état de l'anneau (décoratif, synchronisé sur l'animation CSS) ---------- */
var st=$('#rstate'),arc=$('.prog');
if(reduce)return;
var LAB=[[0,MSG['mq.lg.576']],[.4,MSG['mq.lg.649']],[.85,MSG['mq.lg.577']]],T=0;
st.textContent=MSG['mq.lg.576'];
arc.addEventListener('animationstart',function(e){if(e.animationName==='tune')T=performance.now();});
arc.addEventListener('animationiteration',function(e){if(e.animationName==='tune')T=performance.now();});
var last='';
(function tick(now){requestAnimationFrame(tick);if(!T)return;var p=((now-T)/5000)%1,t=LAB[0][1];
  for(var i=0;i<LAB.length;i++)if(p>=LAB[i][0])t=LAB[i][1];if(t!==last){st.textContent=t;last=t;}})(0);
})();

</script>
</Canon>
