---
import '../styles/maquettes/theme-dark-extra.css';
import '../styles/maquettes/plan.css';
import ReportView from '../components/ReportView.svelte';
import { t } from '../i18n/index.js';
import Canon from '../layouts/Canon.astro';
import '../styles/maquettes/theme-dark-qa.css';
---

<Canon vue="plan" title={t('mq.ui.meta.plan.title')} description={t('plan.lede')}>
