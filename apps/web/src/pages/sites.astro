---
import '../styles/maquettes/liens.css';
import SitesBoard from '../components/SitesBoard.svelte';
import { t } from '../i18n/index.js';
import Canon from '../layouts/Canon.astro';
import '../styles/maquettes/sites-liste.css';
import '../styles/maquettes/sites-vide.css';
---

<Canon
  vue="sites"
  title={t('meta.sites.title')}
  description={t('meta.sites.description')}
  robots="noindex, nofollow"
>
  <SitesBoard client:load />
</Canon>
