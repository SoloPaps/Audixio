              <h3>{t('mq.a.032')}</h3>
              <span class="p-grade"><span class="grade g-c"><span class="sr-only">{t('mq.a.060')} </span>{t('mq.a.019')}</span><small>{t('mq.a.060')}</small></span>
            </header>
            <p class="p-desc">{t('mq.a.061')}</p>
            <div class="p-sec"><h4>{t('mq.a.062')}</h4><ul class="chips" role="list"><li>{t('mq.a.063')}</li><li>{t('mq.a.064')}</li><li>{t('mq.a.065')}</li><li>{t('mq.a.066')}</li><li>{t('mq.a.067')}</li></ul></div>
