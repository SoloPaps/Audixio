---
import '../styles/maquettes/theme-dark-extra.css';
import '../styles/maquettes/robot.css';
import { t } from '../i18n/index.js';
import Canon from '../layouts/Canon.astro';

const messages = {
  'mq.lg.492': t('mq.lg.492'),
  'mq.lg.493': t('mq.lg.493'),
  'mq.lg.494': t('mq.lg.494'),
  'mq.lg.495': t('mq.lg.495'),
  'mq.lg.496': t('mq.lg.496'),
  'mq.lg.robot.ok': t('mq.lg.robot.ok'),
  'mq.lg.robot.stop': t('mq.lg.robot.stop'),
};
---

<Canon vue="robot" title={t('mq.meta.robot.title')} description={t('mq.meta.robot.desc')} robots="index, follow">
<main id="contenu" tabindex="-1" data-reading="1" data-copy-prefix={t('mq.lg.111')}>
<div class="progress" aria-hidden="true"></div>
<nav class="crumbs" aria-label={t('mq.lg.001')}><ol><li><a href="/">{t('mq.lg.002')}</a></li><li>{t('mq.lg.003')}</li><li><span aria-current="page">{t('mq.lg.097')}</span></li></ol></nav>
<div class="hero l-hero"><div data-stagger>
<p class="eyebrow rv"><span class="dot" aria-hidden="true"></span>{t('mq.lg.419')}</p>
<h1 class="rv">{t('mq.lg.097')}</h1>
<p class="lede rv">{t('mq.lg.420')}</p>
<div class="meta rv"><span class="chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>{t('mq.lg.007')}<time datetime="2026-10-30">{t('mq.lg.421')}</time>{t('mq.lg.009')}</span></span><span class="badge b-ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg>{t('mq.lg.422')}</span></div></div>
<div class="emblem" aria-hidden="true"><svg viewBox="0 0 300 300"><defs><radialGradient id="halo"><stop offset="0" stop-color="#fff" stop-opacity=".95"/><stop offset="1" stop-color="#DDE4F8" stop-opacity=".15"/></radialGradient></defs>
<circle class="halo" cx="150" cy="150" r="128"/><circle class="ring" cx="150" cy="150" r="128"/><circle class="ring" cx="150" cy="150" r="96" stroke-dasharray="3 7"/>
<g class="orb"><circle cx="150" cy="22" r="6"/><circle cx="278" cy="150" r="4" opacity=".6"/></g><g class="floaty"><path class="draw" d="M150 66v168M98 234h104M86 100h128"/><path class="draw b" d="M108 100l-28 58a28 28 0 0 0 56 0zM192 100l-28 58a28 28 0 0 0 56 0z"/></g></svg></div></div>
<section aria-labelledby="recap"><h2 id="recap" class="sr-only">{t('mq.lg.011')}</h2><div class="grid2 recap" data-stagger>
<div class="tile card rv tilt"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="8" width="16" height="12" rx="3"/><path d="M12 8V4M9 14h.01M15 14h.01M2 13v3M22 13v3"/></svg></span><p class="kicker">{t('mq.lg.423')}</p><h3 style="margin-top:8px">{t('mq.lg.424')}</h3><p>{t('mq.lg.425')}</p></div>
<div class="tile card rv tilt"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17a8 8 0 1 1 16 0"/><path d="M12 17l4-5"/></svg></span><p class="kicker">{t('mq.lg.426')}</p><h3 style="margin-top:8px"><strong data-count="50">{t('mq.lg.427')}</strong>{t('mq.lg.428')}</h3><p>{t('mq.lg.429')}</p></div>
<div class="tile card rv tilt"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg></span><p class="kicker">{t('mq.lg.430')}</p><h3 style="margin-top:8px">{t('mq.lg.431')}</h3><p>{t('mq.lg.432')}</p></div>
<div class="tile card rv tilt"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 7l9 6 9-6"/></svg></span><p class="kicker">{t('mq.lg.433')}</p><h3 style="margin-top:8px"><a href="mailto:Audixio@outlook.fr">{t('mq.lg.022')}<wbr>{t('mq.lg.023')}</a></h3><p>{t('mq.lg.434')}<strong data-count="48">{t('mq.lg.025')}</strong>{t('mq.lg.026')}</p></div></div></section><div class="layout"><nav class="toc card rv" aria-label={t('mq.lg.027')}><p class="kicker">{t('mq.lg.323')}</p><ol><li><a href="#role"><span class="n">{t('mq.lg.029')}</span>{t('mq.lg.435')}</a></li><li><a href="#identifier"><span class="n">{t('mq.lg.031')}</span>{t('mq.lg.436')}</a></li><li><a href="#budget"><span class="n">{t('mq.lg.033')}</span>{t('mq.lg.426')}</a></li><li><a href="#robots"><span class="n">{t('mq.lg.035')}</span>{t('mq.lg.437')}</a></li><li><a href="#opt-out"><span class="n">{t('mq.lg.037')}</span>{t('mq.lg.438')}</a></li></ol><p class="note">{t('mq.lg.041')}</p></nav><div class="chapters"><section class="chap card pad rv sheen" id="role" tabindex="-1" aria-labelledby="role-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.029')}</span><div><p class="kicker">{t('mq.lg.439')}<span class="badge b-own">{t('mq.lg.043')}</span></p><h2 id="role-t"><span class="sr-only">{t('mq.lg.044')}</span>{t('mq.lg.440')}</h2></div></div><p class="prose">{t('mq.lg.441')}</p><ul class="ticks" data-stagger><li style="--i:0"><span class="t"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg></span><span><strong>{t('mq.lg.442')}</strong>{t('mq.lg.443')}</span></li><li style="--i:1"><span class="t"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg></span><span><strong>{t('mq.lg.444')}</strong>{t('mq.lg.445')}</span></li><li style="--i:2"><span class="t"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg></span><span><strong>{t('mq.lg.446')}</strong>{t('mq.lg.447')}</span></li></ul></section>
<section class="chap card pad rv sheen" id="identifier" tabindex="-1" aria-labelledby="identifier-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.031')}</span><div><p class="kicker">{t('mq.lg.448')}<span class="badge b-ok">{t('mq.lg.449')}</span></p><h2 id="identifier-t"><span class="sr-only">{t('mq.lg.054')}</span>{t('mq.lg.450')}</h2></div></div><p class="prose">{t('mq.lg.451')}</p><div class="mail card rv"><div><p class="lbl">{t('mq.lg.452')}</p><code class="addr" style="font-size:14px;word-break:break-all">{t('mq.lg.453')}</code></div><div class="acts"><button type="button" class="btn btn-ghost copy" data-copy="Mozilla/5.0 (compatible; AudixioBot/1.0; +https://audixio.fr/robot)"><span class="cp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M5 15V6a2 2 0 0 1 2-2h8"/></svg></span><span class="ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg></span>{t('mq.lg.454')}</button></div></div><p class="prose" style="margin-top:var(--s3)">{t('mq.lg.455')}<code>{t('mq.lg.437')}</code>&nbsp;: <code>{t('mq.lg.456')}</code>.</p></section>
<section class="chap card pad rv sheen" id="budget" tabindex="-1" aria-labelledby="budget-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.033')}</span><div><p class="kicker">{t('mq.lg.457')}<span class="badge b-chk">{t('mq.lg.458')}</span></p><h2 id="budget-t"><span class="sr-only">{t('mq.lg.063')}</span>{t('mq.lg.459')}</h2></div></div><ul class="ticks" data-stagger><li style="--i:0"><span class="t"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg></span><span><strong>{t('mq.lg.460')}</strong>{t('mq.lg.461')}</span></li><li style="--i:1"><span class="t"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg></span><span><strong>{t('mq.lg.462')}</strong>{t('mq.lg.463')}</span></li><li style="--i:2"><span class="t"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg></span><span><strong>{t('mq.lg.464')}</strong>{t('mq.lg.465')}</span></li></ul></section>
<section class="chap card pad rv sheen" id="robots" tabindex="-1" aria-labelledby="robots-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.035')}</span><div><p class="kicker">{t('mq.lg.466')}<span class="badge b-ok">{t('mq.lg.467')}</span></p><h2 id="robots-t"><span class="sr-only">{t('mq.lg.069')}</span>{t('mq.lg.431')}</h2></div></div><p class="prose">{t('mq.lg.468')}<code>{t('mq.lg.437')}</code>{t('mq.lg.469')}<code>{t('mq.lg.470')}</code>{t('mq.lg.471')}<code>{t('mq.lg.472')}</code>{t('mq.lg.473')}<code>{t('mq.lg.456')}</code>{t('mq.lg.474')}<code>*</code>{t('mq.lg.475')}</p><pre class="card robots-ex" style="margin-top:var(--s3);padding:16px;overflow:auto;font-size:14px"><code>{t('mq.lg.476')}</code></pre></section>
<section class="chap card pad rv sheen" id="opt-out" tabindex="-1" aria-labelledby="opt-out-t">
<div class="chap-h"><span class="cnum" aria-hidden="true"><svg viewBox="0 0 56 56"><circle class="bg" cx="28" cy="28" r="26"/><circle class="fg" cx="28" cy="28" r="26"/></svg>{t('mq.lg.037')}</span><div><p class="kicker">{t('mq.lg.477')}<span class="badge b-own">{t('mq.lg.478')}</span></p><h2 id="opt-out-t"><span class="sr-only">{t('mq.lg.078')}</span>{t('mq.lg.479')}</h2></div></div><p class="prose">{t('mq.lg.480')}</p><form class="oo card rv" id="oo" novalidate><div class="oo-f"><label for="oo-d">{t('mq.lg.481')}</label><input id="oo-d" name="d" type="text" inputmode="url" autocomplete="url" placeholder={t('mq.lg.482')} required></div><div class="oo-f"><label for="oo-m">{t('mq.lg.483')}</label><input id="oo-m" name="m" type="email" autocomplete="email" placeholder={t('mq.lg.484')} required></div><div class="oo-f oo-w"><label for="oo-r">{t('mq.lg.485')}</label><textarea id="oo-r" name="r" rows="3" maxlength="600"></textarea></div><button class="btn btn-primary oo-w" type="submit">{t('mq.lg.486')}</button><p class="oo-st oo-w" id="oo-st" role="status" aria-live="polite"></p></form><div class="mail card rv"><div><p class="lbl">{t('mq.lg.487')}</p><a class="addr" href="mailto:Audixio@outlook.fr">{t('mq.lg.100')}</a><p class="lbl" style="margin:8px 0 0">{t('mq.lg.488')}</p></div><div class="acts"><button type="button" class="btn btn-ghost copy" data-copy="Audixio@outlook.fr"><span class="cp"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M5 15V6a2 2 0 0 1 2-2h8"/></svg></span><span class="ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg></span>{t('mq.lg.102')}</button><a class="btn btn-primary" href="mailto:Audixio@outlook.fr?subject=Abus%20du%20robot%20Audixio">{t('mq.lg.103')}</a></div></div></section></div></div>
<section class="end card rv sheen" aria-labelledby="end-t"><h2 id="end-t">{t('mq.lg.489')}</h2><p>{t('mq.lg.490')}</p><div class="acts"><a class="btn btn-primary" href="mailto:Audixio@outlook.fr?subject=Question%20sur%20le%20robot%20Audixio">{t('mq.lg.106')}</a><a class="btn btn-ghost" href="/">{t('mq.lg.107')}</a></div><p class="rel">{t('mq.lg.108')}<a href="/mentions-legales">{t('mq.lg.004')}</a> · <a href="/cgu">{t('mq.lg.491')}</a> · <a href="/confidentialite">{t('mq.lg.110')}</a></p></section>
<div class="toast" id="toast" aria-hidden="true"></div><p class="sr-only" id="live" role="status" aria-live="polite"></p>
</main>
<script type="application/json" id="i18n-msg" set:html={JSON.stringify(messages)}></script>
<script>
import { bindMaquetteMotion, bindReadingAids } from '../lib/motion';
bindMaquetteMotion();
const root = document.getElementById('contenu');
if (root?.dataset.reading === '1') bindReadingAids(root.dataset.copyPrefix ?? '');
document.dispatchEvent(new Event('audixio-motion'));
</script>
<script is:inline>
var MSG = JSON.parse(document.getElementById('i18n-msg').textContent);
(function(){var f=document.getElementById('oo');if(!f)return;var st=document.getElementById('oo-st');f.addEventListener('submit',function(e){e.preventDefault();var ok=true;[f.d,f.m].forEach(function(x){var v=x.checkValidity()&&x.value.trim();x.setAttribute('aria-invalid',v?'false':'true');if(!v)ok=false});if(!ok){st.className=MSG['mq.lg.492'];st.textContent=MSG['mq.lg.493'];return}var btn=f.querySelector('button[type=submit]');if(btn)btn.disabled=true;fetch('/api/robot',{method:'post',headers:{'content-type':'application/json','accept':'application/json'},credentials:'same-origin',body:JSON.stringify({domain:f.d.value.trim(),email:f.m.value.trim(),reason:(f.r&&f.r.value?f.r.value:'').trim()})}).then(function(res){if(btn)btn.disabled=false;if(res.status===429){st.className=MSG['mq.lg.492'];st.textContent=MSG['mq.lg.robot.stop'];return}if(!res.ok){st.className=MSG['mq.lg.492'];st.textContent=MSG['mq.lg.493'];return}st.className=MSG['mq.lg.494'];st.textContent=MSG['mq.lg.robot.ok']+' '+f.m.value.trim()+' '+f.d.value.trim();f.reset()}).catch(function(){if(btn)btn.disabled=false;st.className=MSG['mq.lg.492'];st.textContent=MSG['mq.lg.493']})})})();
</script>
</Canon>
