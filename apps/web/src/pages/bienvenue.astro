---
import '../styles/maquettes/liens.css';
import WelcomeBoard from '../components/WelcomeBoard.svelte';
import { t } from '../i18n/index.js';
import Canon from '../layouts/Canon.astro';
import '../styles/maquettes/bienvenue.css';
---

<Canon
  vue="bienvenue"
  title={t('meta.welcome.title')}
  description={t('meta.welcome.description')}
  robots="noindex, nofollow"
>
  <WelcomeBoard client:load />
</Canon>
