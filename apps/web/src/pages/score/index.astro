---
import PublicScore from '../../components/PublicScore.svelte';
import { t } from '../../i18n/index.js';
import V6Page from '../../layouts/V6Page.astro';
import '../../styles/maquettes/score-public-v6.css';
import '../../styles/maquettes/public-hub-v6.css';
---

<V6Page
  vue="score"
  title={t('meta.score.title')}
  description={t('meta.score.description')}
  robots={false}
>
  <div class="sp" data-port>
  <main id="contenu" class="score-page">
    <PublicScore mode="public" client:load />
  </main>
  </div>
</V6Page>
