---
import '../../styles/maquettes/constat-v6.css';
import GuestReportRedirect from '../../components/GuestReportRedirect.astro';
import ReportView from '../../components/ReportView.svelte';
import { t } from '../../i18n/index.js';
import V6Page from '../../layouts/V6Page.astro';
---

<V6Page vue="constat" title={t('mq.ui.meta.constat.title')} description={t('meta.domain.description')}>
  <GuestReportRedirect slot="head" mode="detail" />
  <main id="contenu" class="r6-con" tabindex="-1">
    <ReportView mode="detail" client:load />
  </main>
</V6Page>
