---
import '../styles/maquettes/theme-dark-extra.css';
import AccountBoard from '../components/AccountBoard.svelte';
import SearchConsolePanel from '../components/SearchConsolePanel.svelte';
import { t } from '../i18n/index.js';
import Canon from '../layouts/Canon.astro';
import '../styles/maquettes/compte.css';
import '../styles/maquettes/theme-dark-qa.css';
---

<Canon
  vue="compte"
  title={t('meta.account.title')}
  description={t('meta.account.description')}
  robots="noindex, nofollow"
>
  <AccountBoard client:load />
  <section class="blk" id="search-console" aria-label={t('gsc.connect')}>
    <SearchConsolePanel client:load />
  </section>
</Canon>
