---
import '../styles/maquettes/theme-dark-extra.css';
import '../styles/maquettes/auth.css';
import ResetForm from '../components/ResetForm.svelte';
import { t } from '../i18n/index.js';
import Canon from '../layouts/Canon.astro';
---

<Canon vue="auth" title={t('meta.reset.title')} description={t('meta.reset.description')}>
  <main id="contenu" class="auth-doc" tabindex="-1">
    <ResetForm
      renew={Astro.url.searchParams.get('etape') === 'nouveau'}
      client:load
    />
  </main>
</Canon>
