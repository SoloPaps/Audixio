---
import AfterNote from '../components/v6/accueil/AfterNote.astro';
import DomainsXray from '../components/v6/accueil/DomainsXray.astro';
import ExplodedView from '../components/v6/accueil/ExplodedView.astro';
import Faq from '../components/v6/accueil/Faq.astro';
import FinalCta from '../components/v6/accueil/FinalCta.astro';
import HeroScan from '../components/v6/accueil/HeroScan.astro';
import HowItWorks from '../components/v6/accueil/HowItWorks.astro';
import Plans from '../components/v6/accueil/Plans.astro';
import ReportPreview from '../components/v6/accueil/ReportPreview.astro';
import SpotGame from '../components/v6/accueil/SpotGame.astro';
import SectionDock from '../components/v6/SectionDock.svelte';
import { t } from '../i18n/index.js';
import V6Page from '../layouts/V6Page.astro';
import '../styles/maquettes/accueil-v6.css';

const sections = [
  { id: 'comment', label: t('ac.045') },
  { id: 'domaines', label: t('ac.065') },
  { id: 'couches', label: t('ac.151') },
  { id: 'jeu', label: t('ac.190') },
  { id: 'rapport', label: t('ac.206') },
  { id: 'suite', label: t('ac.235') },
  { id: 'tarifs', label: t('ac.257') },
  { id: 'faq', label: t('ac.274') },
];
---

<V6Page
  vue="accueil"
  title={t('mq.ui.meta.home.title')}
  description={t('meta.home.description')}
  robots="index, follow"
>
  <main id="contenu" class="ac">
    <HeroScan />
    <HowItWorks />
    <DomainsXray />
    <ExplodedView />
    <SpotGame />
    <ReportPreview />
    <AfterNote />
    <Plans />
    <Faq />
    <FinalCta />
  </main>
  <SectionDock {sections} client:idle />
</V6Page>

<script>
  import { bootAccueil } from '../lib/motion/accueil-v6';

  const root = document.querySelector<HTMLElement>('main.ac');
  if (root) bootAccueil(root);
</script>
