---
import '../styles/maquettes/domaine.css';
import '../styles/maquettes/restreint.css';
import ReportView from '../components/ReportView.svelte';
import { t } from '../i18n/index.js';
import Canon from '../layouts/Canon.astro';
---

<Canon vue="domaine" title={t('meta.domain.title')} description={t('meta.domain.description')}>
  <main id="contenu" tabindex="-1">
    <ReportView mode="domain" client:load />
  </main>
</Canon>
