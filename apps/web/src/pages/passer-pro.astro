---
import { t } from '../i18n/index.js';
import V6Page from '../layouts/V6Page.astro';

/**
 * R14 : /passer-pro n’est plus une page, la fenêtre Pro vit sur /sites.
 * Visiteur et compte gratuit vont sur /pro (requête et ancre gardées),
 * un compte Pro va sur /compte (#38). Le renvoi se fait côté page.
 */
---

<V6Page vue="passer" title={t('mq.passer.meta.title')} description={t('mq.passer.meta.desc')} robots="noindex, nofollow">
<script is:inline>
try{var c=(document.cookie||'').split('; ').indexOf('audixio_connecte=1')>=0,l=false;try{l=!!localStorage.getItem('audigy-auth')}catch(e){}if(!c&&!l)location.replace('/pro'+location.search+location.hash)}catch(e){location.replace('/pro')}
</script>
<main id="contenu" class="wrap pp6" tabindex="-1">
  <h1>{t('mq.passer.015')}</h1>
  <p><a class="lnk" href="/pro">{t('mq.passer.040')}</a></p>
</main>
<script>
import { routeUpgrade } from '../lib/pro-redirect.js';
void routeUpgrade(
  (href) => location.replace(href),
  location.search + location.hash,
);
</script>
<style>
  .pp6 {
    padding-block: calc(var(--hh) + var(--s-10)) var(--s-10);
  }
</style>
</V6Page>
